ASPNETCORE_ENVIRONMENT=Development
# Observability (mt6_13, audit P0-5, ADR-0065): push OTLP to the compose `observability` profile's collector. On by
# default so a containerized dev stack is observable like bare-run; when the profile is not up the exporter only
# drops its batches (no crash, no request is slowed). Comment out to silence the exporter entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Release identity (ADR-0064): the deployment environment every span/metric/log is tagged with. Explicit, so it
# wins over the ASPNETCORE_ENVIRONMENT mapping (a prod-configured test stage still reports "test").
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# Verbose dev logging so failures carry their own diagnosis (compose-smoke / live debugging).
# Default=Debug surfaces app + EF SQL (logged at Information) + MassTransit. Override per-deploy if noisy.
Logging__LogLevel__Default=Debug
Logging__LogLevel__Microsoft.AspNetCore=Information
Logging__LogLevel__MassTransit=Debug

# ── Optional knobs (containerized dev). Uncomment to activate; ASP.NET maps `__` to `:`.
# Payments (ADR-0039): Development defaults to Mode=LocalMock + AllowMockEmail=true via
# appsettings.Development.json — no env needed here. Outside Development, PaymentModeGuard
# refuses LocalMock/AllowMockEmail at boot; set Sandbox/Production + provider creds per
# docs/ops/secrets.md instead.
#Payments__MockEmailTo=dev-payments@localhost
# Quartz schedulers (Payments daily-journal, Marketing scheduled-publish sweep): on by default.
#Scheduling__Enabled=false
# Identity MFA floor (0=None): raise to require MFA for platform operators.
#Mfa__PlatformMinimum=0
# Continuous profiling (ADR-0068): every .NET image carries the Pyroscope .NET profiler (Linux-only native CLR
# profiler), inert until these are set. Uncomment to profile the containerized stack into the `observability`
# profile's Pyroscope (http://localhost:4040, Grafana → Explore → Pyroscope; spans link to their profiles). Off by
# default so compose-smoke and plain launches do not load a profiler they have no backend for.
#CORECLR_ENABLE_PROFILING=1
#LD_PRELOAD=/pyroscope/Pyroscope.Linux.ApiWrapper.x64.so
#PYROSCOPE_PROFILING_ENABLED=true
#PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
#PYROSCOPE_LABELS=deployment_environment_name:dev
#PYROSCOPE_PROFILING_ALLOCATION_ENABLED=true
#PYROSCOPE_PROFILING_LOCK_ENABLED=true
#PYROSCOPE_PROFILING_EXCEPTION_ENABLED=true
