# GlitchTip error inbox — LOCAL DEV ONLY (ADR-0067). The one place that names the dev inbox's identities:
#   - the infra compose `glitchtip` service reads this file (env_file) and its entrypoint bootstraps exactly these
#     projects, keys and API token into the `glitchtip` database on every start (idempotent);
#   - scripts/lib/glitchtip.sh reads it to hand bare-run processes their SENTRY_DSN (run-all.sh, dev-up.sh,
#     e2e-verify.sh) and to query the inbox (e2e-verify L20c, doctor.sh).
# These are throwaway dev values like the Postgres/RabbitMQ dev passwords: never reuse them anywhere deployed.
# Production creates its own projects in its own GlitchTip and passes the DSNs as a Secret (Helm errorTracking.dsnSecret).

# Sign-in for the GlitchTip UI (http://localhost:8000).
GLITCHTIP_DEV_ADMIN_EMAIL=admin@3commerce.dev
GLITCHTIP_DEV_ADMIN_PASSWORD=glitchtip_dev

# Organisation + the two projects: every .NET host (services, gateway, worker, Admin, Supplier Portal) reports to
# `backend`; the storefront (browser errors via the /rum relay + SSR errors) to `storefront`.
# DSN = http://<public key>@<host>:<port>/<project id>. The bootstrap creates each project with the id and key in its DSN.
GLITCHTIP_DEV_ORG=3commerce
GLITCHTIP_DEV_BACKEND_DSN=http://60d5721759da497aa5ca48a4c93424a1@localhost:8000/1
GLITCHTIP_DEV_STOREFRONT_DSN=http://685233df550a43af8410f48e60785466@localhost:8000/2

# A read-only API token for scripts (issues/events queries); scopes are set by the bootstrap.
GLITCHTIP_DEV_API_TOKEN=3908c8d224de2fef15f695af73f15095e243114cbbeadd30e0773e31fc48ee6a
