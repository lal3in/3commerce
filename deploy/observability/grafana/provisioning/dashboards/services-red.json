{
  "uid": "3commerce-services-red",
  "title": "3commerce — Services (RED)",
  "description": "Rate/Errors/Duration per service. Queries Mimir (uid `mimir`), not Prometheus: Mimir is the durable store (named volume) and is reachable from the host, while the Prometheus container keeps no volume and publishes no port, so its copy of the same series dies with the container. Datasource uids are pinned — a `${DS_PROMETHEUS}` style placeholder only resolves on manual import and leaves every panel dataless when provisioned from a file.",
  "tags": ["3commerce", "mt6_13"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s) by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (5xx, req/s) by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 request duration by service",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Running releases by service (ADR-0064)",
      "description": "Which build each service runs: service.version (<version>+<sha7>[-dirty]), the full commit (vcs.ref.head.revision) and the deployment environment — the release resource every span/metric/log carries. A service listed twice is mid-rollout, or two generations are running.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "group by (service_name, service_version, vcs_ref_head_revision, deployment_environment_name) (http_server_request_duration_seconds_count)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true },
            "indexByName": { "service_name": 0, "service_version": 1, "vcs_ref_head_revision": 2, "deployment_environment_name": 3 },
            "renameByName": { "service_name": "service", "service_version": "service.version", "vcs_ref_head_revision": "commit", "deployment_environment_name": "environment" }
          }
        }
      ]
    }
  ]
}
