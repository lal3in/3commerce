@page "/"
@attribute [Authorize(Roles = "admin")]
@inject GatewayClient Gateway
@rendermode AdminRenderModes.InteractiveServerNoPrerender

<div style="display:flex; align-items:baseline; gap:1rem; flex-wrap:wrap;">
    <h1 style="margin:0;">@L["Home.Title"]</h1>
    <span style="color:#6b7280; font-size:.85rem;">@L["Home.Subtitle"]</span>
    <span style="flex:1;"></span>
    <label style="font-size:.85rem; color:#374151;">@L["Home.Filter.Storefront"]:
        <select value="@_selectedStore" @onchange="OnStoreChanged" style="padding:.35rem .5rem; margin-left:.3rem;">
            <option value="">@L["Home.Filter.AllStores"]</option>
            @foreach (var s in _storefronts)
            {
                <option value="@s.Id">@s.Name (@s.Currency)</option>
            }
            <option value="unassigned">@L["Home.Filter.Unassigned"]</option>
        </select>
    </label>
    <button @onclick="LoadAsync" title="@L["Common.Refresh.Tip"]" style="padding:.35rem .8rem;">↻ @L["Common.Refresh"]</button>
</div>

@if (_loading)
{
    <p style="margin-top:1rem;">@L["Home.Loading"]</p>
}
else
{
    @* Count KPIs (scoped to the selected storefront where meaningful). Products is catalog-wide. *@
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:1rem; margin-top:1.2rem;">
        @KpiCard(L["Home.Kpi.Orders"], Orders.Count.ToString(), "#0891b2", L["Home.Kpi.Orders.Sub", OrdersToday], L["Home.Kpi.Orders.Tip"])
        @KpiCard(L["Home.Kpi.Products"], _productCount.ToString(), "#059669", L["Home.Kpi.Products.Sub"], L["Home.Kpi.Products.Tip"])
        @KpiCard(L["Home.Kpi.OpenRmas"], OpenRmas.ToString(), OpenRmas > 0 ? "#d97706" : "#059669", L["Home.Kpi.OpenRmas.Sub", ScopedRmas.Count], L["Home.Kpi.OpenRmas.Tip"])
        @KpiCard(L["Home.Kpi.Ledger"], _trialBalanceMinor == 0 ? "✓" : "!", _trialBalanceMinor == 0 ? "#059669" : "#dc2626", _trialBalanceMinor == 0 ? L["Home.Kpi.Balanced"] : L["Home.Kpi.OutOfBalance"], L["Home.Kpi.Ledger.Tip"])
    </div>

    @* Money is ALWAYS per currency (minor units aren't comparable across currencies) and comes from the
       full ledger balances, not the truncated recent-entries feed — so it matches the Ledger page. When a
       storefront is selected, revenue/refunds/net are its own accounts and "Cash" becomes its receivable. *@
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1rem; margin-top:1rem;">
        @if (MoneyCurrencies.Count == 0)
        {
            <p style="color:#9ca3af;">@L["Home.NoLedger"]</p>
        }
        else
        {
            @foreach (var cur in MoneyCurrencies)
            {
                <div style="border:1px solid #e5e7eb; border-left:4px solid #4f46e5; border-radius:10px; padding:.8rem 1rem; background:#fff;">
                    <div style="font-weight:700; margin-bottom:.4rem;">@cur</div>
                    <table style="width:100%; border-collapse:collapse; font-size:.9rem;">
                        @MoneyRow(L["Home.Kpi.Revenue"], Revenue(cur), cur, "#111827")
                        @MoneyRow(L["Home.Kpi.Refunds"], -Refunds(cur), cur, Refunds(cur) > 0 ? "#b45309" : "#6b7280")
                        @MoneyRow(L["Home.Kpi.NetRevenue"], Revenue(cur) - Refunds(cur), cur, "#0e7490", bold: true)
                        @if (!IsUnassigned)
                        {
                            @MoneyRow(SelectedStoreId is null ? L["Home.Kpi.Cash"] : L["Home.Kpi.Receivable"], CashOrReceivable(cur), cur, "#4f46e5")
                            @if (SelectedStoreId is null)
                            {
                                @CashBreakdownRow(cur)
                            }
                        }
                    </table>
                </div>
            }
        }
    </div>

    <div style="display:grid; grid-template-columns:2fr 1fr; gap:1.2rem; margin-top:1.4rem;">
        <div style="border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.2rem; background:#fff;">
            <div style="display:flex; align-items:baseline; gap:1rem; margin:0 0 .6rem;">
                <h3 style="margin:0;">@L["Home.Revenue14"]</h3>
                <span style="flex:1;"></span>
                <span style="font-size:.75rem; color:#6b7280;"><span style="color:#6366f1;">■</span> @L["Home.Chart.Gross"] &nbsp; <span style="color:#f59e0b;">■</span> @L["Home.Chart.Refunds"]</span>
            </div>
            @if (_revByDay.Count == 0)
            {
                <p style="color:#9ca3af;">@L["Home.NoOrders"]</p>
            }
            else
            {
                <svg viewBox="0 0 580 170" style="width:100%; height:170px;">@ChartSvg()</svg>
            }
        </div>

        <div style="border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.2rem; background:#fff;">
            <h3 style="margin:0 0 .6rem;">@L["Home.OrdersByStatus"]</h3>
            @if (ByStatus.Count == 0)
            {
                <p style="color:#9ca3af;">—</p>
            }
            else
            {
                @foreach (var kv in ByStatus.OrderByDescending(s => s.Value))
                {
                    var pct = Orders.Count > 0 ? kv.Value * 100 / Orders.Count : 0;
                    <div style="margin-bottom:.5rem;">
                        <div style="display:flex; justify-content:space-between; font-size:.85rem;"><span>@kv.Key</span><span style="color:#6b7280;">@kv.Value</span></div>
                        <div style="background:#f3f4f6; border-radius:6px; height:8px; overflow:hidden;"><div style="width:@(pct)%; height:100%; background:#0891b2;"></div></div>
                    </div>
                }
            }
        </div>
    </div>

    <div style="border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.2rem; background:#fff; margin-top:1.2rem;">
        <h3 style="margin:0 0 .6rem;">@L["Home.RecentOrders"]</h3>
        @if (Orders.Count == 0)
        {
            <p style="color:#9ca3af;">@L["Home.NoOrders"]</p>
        }
        else
        {
            <table style="border-collapse:collapse; width:100%; font-size:.9rem;">
                <thead><tr><th style="text-align:left;">@L["Home.Col.When"]</th><th style="text-align:left;">@L["Home.Col.Order"]</th><th style="text-align:left;">@L["Home.Col.Status"]</th><th style="text-align:right;">@L["Home.Col.Amount"]</th></tr></thead>
                <tbody>
                @foreach (var o in Orders.OrderByDescending(o => o.CreatedAt).Take(8))
                {
                    <tr style="border-top:1px solid #f3f4f6;">
                        <td>@o.CreatedAt.LocalDateTime.ToString("dd MMM HH:mm")</td>
                        <td><code style="font-size:.8rem;">@o.Id.ToString()[..8]</code></td>
                        <td>@o.Status</td>
                        <td style="text-align:right;">@($"{o.GrossMinor / 100m:0.00} {o.Currency}")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    <div style="border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.2rem; background:#fff; margin-top:1.2rem;">
        <div style="display:flex; align-items:baseline; gap:1rem;">
            <h3 style="margin:0 0 .6rem;">@L["Home.LedgerFeed"]</h3>
            <span style="flex:1;"></span>
            <a href="/ledger" style="font-size:.8rem;" title="@L["Nav.Ledger.Tip"]">@L["Home.LedgerFeed.All"]</a>
        </div>
        @if (ScopedLedger.Count == 0)
        {
            <p style="color:#9ca3af;">@L["Home.NoLedger"]</p>
        }
        else
        {
            <table style="border-collapse:collapse; width:100%; font-size:.9rem;">
                <thead><tr><th style="text-align:left;">@L["Home.Col.When"]</th><th style="text-align:left;">@L["Home.Col.Entry"]</th><th style="text-align:right;">@L["Home.Col.Amount"]</th></tr></thead>
                <tbody>
                @foreach (var e in ScopedLedger.OrderByDescending(e => e.CreatedAt).Take(8))
                {
                    var isRefund = e.Description.StartsWith("Refund ", StringComparison.Ordinal);
                    var cashLines = e.Lines.Where(l => l.AccountCode.StartsWith("cash.", StringComparison.Ordinal));
                    var total = isRefund ? cashLines.Sum(l => l.CreditMinor) : cashLines.Sum(l => l.DebitMinor);
                    <tr style="border-top:1px solid #f3f4f6;">
                        <td>@e.CreatedAt.LocalDateTime.ToString("dd MMM HH:mm")</td>
                        <td>@e.Description</td>
                        <td style="text-align:right; @(isRefund ? "color:#b45309;" : "color:#047857;")">@(isRefund ? "−" : "")@($"{total / 100m:0.00} {e.Currency}")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private const string Tenant = "00000000-0000-0000-0000-000000000001";
    private bool _loading = true;
    private List<OrderDto> _orders = [];
    private List<RmaDto> _rmas = [];
    private List<EntryDto> _ledger = [];        // recent entries (feed + 14-day chart)
    private List<BalanceDto> _balances = [];    // full per-(account,currency) balances (authoritative money)
    private List<StorefrontDto> _storefronts = [];
    private int _productCount;
    private long _trialBalanceMinor;
    private string _selectedStore = ""; // "" = all storefronts
    private Dictionary<DateTime, long> _revByDay = [];
    private Dictionary<DateTime, long> _refByDay = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private void OnStoreChanged(ChangeEventArgs e)
    {
        _selectedStore = e.Value?.ToString() ?? "";
        RecomputeChart();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var ordersTask = Gateway.GetListAsync<OrderDto>("/api/ordering/admin/orders");
        var rmasTask = Gateway.GetListAsync<RmaDto>("/api/support/admin/rmas");
        var ledgerTask = Gateway.GetListAsync<EntryDto>("/api/payments/admin/ledger/entries");
        var balancesTask = Gateway.GetListAsync<BalanceDto>("/api/payments/admin/ledger/balances");
        var storesTask = Gateway.GetListAsync<StorefrontDto>($"/api/catalog/admin/storefronts?tenantId={Tenant}");
        var productsTask = Gateway.GetListAsync<ProductDto>("/api/catalog/admin/products?pageSize=200");
        await Task.WhenAll(ordersTask, rmasTask, ledgerTask, balancesTask, storesTask, productsTask);

        _orders = await ordersTask;
        _rmas = await rmasTask;
        _ledger = await ledgerTask;
        _balances = await balancesTask;
        _storefronts = await storesTask;
        _productCount = (await productsTask).Count;
        // Trial balance is a global books-health check (across every currency each entry balances).
        _trialBalanceMinor = _balances.Sum(b => b.DebitMinor - b.CreditMinor);

        RecomputeChart();
        _loading = false;
    }

    // ---- storefront scope: "" = all, a guid = that store, "unassigned" = revenue not owned by any
    // storefront (default-storefront orders → revenue.sales, legacy refunds → revenue.refunds). So
    // All == Σ(stores) + Unassigned, which is why per-store totals don't sum to All on their own. ----
    private Guid? SelectedStoreId => Guid.TryParse(_selectedStore, out var id) ? id : null;
    private bool IsUnassigned => _selectedStore == "unassigned";
    private StorefrontDto? SelectedStore => _storefronts.FirstOrDefault(s => s.Id == SelectedStoreId);
    private HashSet<string> StoreRevenueAccounts => _storefronts.Select(s => s.RevenueAccountCode).ToHashSet(StringComparer.Ordinal);

    private List<OrderDto> Orders =>
        IsUnassigned ? _orders.Where(o => o.StorefrontId is null || _storefronts.All(s => s.Id != o.StorefrontId)).ToList()
        : SelectedStoreId is { } id ? _orders.Where(o => o.StorefrontId == id).ToList()
        : _orders;
    private List<EntryDto> ScopedLedger =>
        SelectedStore is { } s ? _ledger.Where(e => e.Lines.Any(l => l.AccountCode == s.RevenueAccountCode || l.AccountCode == s.ReceivableAccountCode || l.AccountCode == s.TaxAccountCode)).ToList()
        : IsUnassigned ? _ledger.Where(e => e.Lines.Any(l => l.AccountCode.StartsWith("revenue.", StringComparison.Ordinal) && !StoreRevenueAccounts.Contains(l.AccountCode))).ToList()
        : _ledger;
    private List<RmaDto> ScopedRmas => (SelectedStoreId is not null || IsUnassigned)
        ? _rmas.Where(r => Orders.Any(o => o.Id == r.OrderId)).ToList()
        : _rmas;
    private int OpenRmas => ScopedRmas.Count(r => r.State is "Requested" or "Pending" or "Open");
    private int OrdersToday => Orders.Count(o => o.CreatedAt.LocalDateTime.Date == DateTime.Now.Date);
    private Dictionary<string, int> ByStatus => Orders.GroupBy(o => o.Status).ToDictionary(g => g.Key, g => g.Count());

    // ---- money, per currency, from the full ledger balances ----
    // Revenue accounts in scope: all revenue.* for "all", else the selected store's revenue account.
    private bool IsScopedRevenue(string code) =>
        IsUnassigned ? code.StartsWith("revenue.", StringComparison.Ordinal) && !StoreRevenueAccounts.Contains(code)
        : SelectedStore is { } s ? code == s.RevenueAccountCode
        : code.StartsWith("revenue.", StringComparison.Ordinal);
    private bool IsScopedCash(string code) =>
        IsUnassigned ? false // unattributed orders post cash directly; cash is platform-level (see All)
        : SelectedStore is { } s ? code == s.ReceivableAccountCode
        : code.StartsWith("cash.", StringComparison.Ordinal);

    private List<string> MoneyCurrencies
    {
        get
        {
            var currencies = _balances
                .Where(b => IsScopedRevenue(b.AccountCode) || IsScopedCash(b.AccountCode))
                .Select(b => b.Currency);
            // A selected store always shows its own currency block (0.00 if it has no sales yet) rather
            // than a blank section, so filtering to a store never looks empty/broken.
            if (SelectedStore is { } s)
            {
                currencies = currencies.Append(s.Currency);
            }

            return currencies.Distinct().OrderBy(c => c, StringComparer.Ordinal).ToList();
        }
    }

    // Revenue credited (net of tax) / refunds debited on the scoped revenue accounts, per currency.
    private long Revenue(string cur) => _balances.Where(b => b.Currency == cur && IsScopedRevenue(b.AccountCode)).Sum(b => b.CreditMinor);
    private long Refunds(string cur) => _balances.Where(b => b.Currency == cur && IsScopedRevenue(b.AccountCode)).Sum(b => b.DebitMinor);
    // Cash held per provider (all) is debit-normal; the store's receivable is also debit-normal.
    private long CashOrReceivable(string cur) => _balances.Where(b => b.Currency == cur && IsScopedCash(b.AccountCode)).Sum(b => b.DebitMinor - b.CreditMinor);
    // Cash-on-hand breakdown components (all-storefronts scope, per currency): cash = net revenue held
    // + tax collected (a liability sitting in cash) − processing fees (an expense paid out of cash).
    private long TaxCollected(string cur) => _balances.Where(b => b.Currency == cur && (b.AccountCode.StartsWith("tax.", StringComparison.Ordinal) || b.AccountCode == "liability.tax_collected")).Sum(b => b.CreditMinor - b.DebitMinor);
    private long Fees(string cur) => _balances.Where(b => b.Currency == cur && b.AccountCode.StartsWith("expense.", StringComparison.Ordinal)).Sum(b => b.DebitMinor - b.CreditMinor);

    private void RecomputeChart()
    {
        _revByDay = [];
        _refByDay = [];
        for (var d = 13; d >= 0; d--)
        {
            var day = DateTime.Now.Date.AddDays(-d);
            _revByDay[day] = Orders.Where(o => o.CreatedAt.LocalDateTime.Date == day).Sum(o => o.GrossMinor);
            _refByDay[day] = ScopedLedger
                .Where(e => e.CreatedAt.LocalDateTime.Date == day && e.Description.StartsWith("Refund ", StringComparison.Ordinal))
                .SelectMany(e => e.Lines).Where(l => l.AccountCode.StartsWith("revenue.", StringComparison.Ordinal)).Sum(l => l.DebitMinor);
        }
    }

    private MarkupString ChartSvg()
    {
        if (_revByDay.Count == 0)
        {
            return default;
        }

        var max = Math.Max(1, Math.Max(_revByDay.Values.Max(), _refByDay.Values.DefaultIfEmpty(0).Max()));
        var parts = _revByDay.Select((kv, i) =>
        {
            var h = kv.Value * 130.0 / max;
            var x = (i * 40) + 14;
            var refund = _refByDay.TryGetValue(kv.Key, out var r) ? r : 0;
            var rh = refund * 130.0 / max;
            var bars = $"<rect x=\"{x}\" y=\"{140 - h:0.#}\" width=\"26\" height=\"{h:0.#}\" rx=\"3\" fill=\"#6366f1\"><title>{kv.Key:dd MMM}: {kv.Value / 100m:N2}</title></rect>";
            if (rh > 0)
            {
                bars += $"<rect x=\"{x + 7}\" y=\"{140 - rh:0.#}\" width=\"12\" height=\"{rh:0.#}\" rx=\"2\" fill=\"#f59e0b\"><title>{kv.Key:dd MMM} · {refund / 100m:N2} refunded</title></rect>";
            }

            return bars + $"<text x=\"{x + 13}\" y=\"158\" font-size=\"9\" text-anchor=\"middle\" fill=\"#9ca3af\">{kv.Key:dd}</text>";
        });
        return (MarkupString)string.Concat(parts);
    }

    // label/tip from resx (trusted); value is our own formatting — nothing user-supplied reaches this markup.
    private RenderFragment KpiCard(string label, string value, string color, string sub, string tip) => builder =>
    {
        builder.AddMarkupContent(0,
            $"<div title=\"{tip}\" style=\"border:1px solid #e5e7eb; border-left:4px solid {color}; border-radius:10px; padding:1rem 1.1rem; background:#fff;\">" +
            $"<div style=\"font-size:.8rem; color:#6b7280; text-transform:uppercase; letter-spacing:.03em;\">{label}</div>" +
            $"<div style=\"font-size:1.7rem; font-weight:700; color:#111827; margin:.2rem 0;\">{value}</div>" +
            $"<div style=\"font-size:.8rem; color:#9ca3af;\">{sub}</div></div>");
    };

    // Expandable "how cash on hand adds up" row: Net revenue + Tax collected − Processing fees = Cash.
    // Native <details> disclosure — no interactivity/state needed. Labels come from resx (trusted).
    private RenderFragment CashBreakdownRow(string cur) => builder =>
    {
        var net = Revenue(cur) - Refunds(cur);
        var tax = TaxCollected(cur);
        var fees = Fees(cur);
        string cell(string lbl, long minor, string color) =>
            $"<tr><td style=\"padding:.1rem 0 .1rem .8rem; color:#6b7280;\">{lbl}</td>" +
            $"<td style=\"text-align:right; color:{color}; font-variant-numeric:tabular-nums;\">{minor / 100m:N2} {cur}</td></tr>";
        builder.AddMarkupContent(0,
            "<tr><td colspan=\"2\" style=\"padding:0;\">" +
            $"<details style=\"margin:.1rem 0 .3rem;\"><summary style=\"cursor:pointer; font-size:.75rem; color:#6b7280;\">{L["Home.Cash.Breakdown"]}</summary>" +
            "<table style=\"width:100%; border-collapse:collapse; font-size:.82rem; margin-top:.2rem;\">" +
            cell(L["Home.Kpi.NetRevenue"], net, "#0e7490") +
            cell("+ " + L["Home.Cash.TaxCollected"], tax, "#374151") +
            cell("− " + L["Home.Cash.Fees"], fees, "#b45309") +
            $"<tr style=\"border-top:1px solid #e5e7eb;\"><td style=\"padding:.15rem 0 .1rem .8rem; font-weight:700;\">= {L["Home.Kpi.Cash"]}</td>" +
            $"<td style=\"text-align:right; font-weight:700; color:#4f46e5; font-variant-numeric:tabular-nums;\">{(net + tax - fees) / 100m:N2} {cur}</td></tr>" +
            "</table></details></td></tr>");
    };

    private RenderFragment MoneyRow(string label, long minor, string currency, string color, bool bold = false) => builder =>
    {
        var weight = bold ? "700" : "400";
        var border = bold ? "border-top:1px solid #e5e7eb;" : "";
        builder.AddMarkupContent(0,
            $"<tr style=\"{border}\"><td style=\"padding:.2rem 0; color:#374151; font-weight:{weight};\">{label}</td>" +
            $"<td style=\"text-align:right; font-weight:{weight}; color:{color}; font-variant-numeric:tabular-nums;\">{minor / 100m:N2} {currency}</td></tr>");
    };

    public record OrderDto(Guid Id, string Status, long GrossMinor, string Currency, DateTimeOffset CreatedAt, string? PaymentOption = null, Guid? StorefrontId = null);
    public record RmaDto(Guid Id, Guid OrderId, string? Email, long AmountMinor, string? Reason, string State, DateTimeOffset CreatedAt);
    public record LineDto(string AccountCode, long DebitMinor, long CreditMinor);
    public record EntryDto(Guid Id, string Description, string Reference, string Currency, DateTimeOffset CreatedAt, List<LineDto> Lines);
    public record BalanceDto(string AccountCode, string Currency, long DebitMinor, long CreditMinor, long NetMinor);
    public record StorefrontDto(Guid Id, string Name, string Currency, string ReceivableAccountCode, string RevenueAccountCode, string TaxAccountCode);
    public record ProductDto(Guid Id);
}
