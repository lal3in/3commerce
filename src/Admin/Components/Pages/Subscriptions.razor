@page "/subscriptions"
@attribute [Authorize(Roles = "admin")]
@inject GatewayClient Gateway
@rendermode AdminRenderModes.InteractiveServerNoPrerender

<h1>@L["Subs.Title"]</h1>
<p style="color:#6b7280;">@L["Subs.Intro"]</p>

@if (_error is not null) { <p style="color:#b91c1c; white-space:pre-wrap;">@_error</p> }
@if (_status is not null) { <p style="color:#047857;">@_status</p> }

@if (_subs is null)
{
    <p>@L["Common.Loading"]</p>
}
else
{
    <div style="display:flex; gap:.6rem; align-items:center; margin:1rem 0;">
        <label>@L["Subs.Filter.Label"]
            <select @bind="_filter" title="@L["Subs.Filter.Tip"]" style="margin-left:.4rem; padding:.3rem;">
                <option value="">@L["Subs.Filter.All"]</option>
                <option value="Active">@L["Subs.Filter.Active"]</option>
                <option value="Trialing">@L["Subs.Filter.Trialing"]</option>
                <option value="PastDue">@L["Subs.Filter.PastDue"]</option>
                <option value="Cancelled">@L["Subs.Filter.Cancelled"]</option>
            </select>
        </label>
        <button @onclick="LoadAsync" title="@L["Common.Refresh.Tip"]" style="padding:.35rem .8rem;">@L["Common.Refresh"]</button>
    </div>

    <table style="width:100%; border-collapse:collapse; font-size:.9rem;">
        <thead><tr style="text-align:left; border-bottom:2px solid #e5e7eb;">
            <th style="padding:.4rem; width:1.5rem;"></th>
            <th style="padding:.4rem;">@L["Subs.Col.Subscriber"]</th>
            <th>@L["Fin.Col.Storefront"]</th>
            <th>@L["Subs.Col.Product"]</th>
            <th>@L["Subs.Col.Status"]</th>
            <th>@L["Subs.Col.Billing"]</th>
            <th>@L["Subs.Col.Period"]</th>
            <th>@L["Subs.Col.Price"]</th>
            <th>@L["Subs.Col.Created"]</th>
            <th>@L["Common.Actions"]</th>
        </tr></thead>
        <tbody>
        @foreach (var s in Filtered)
        {
            <tr style="border-bottom:1px solid #f3f4f6;" data-subscription="@s.Id">
                <td style="padding:.4rem; text-align:center;">
                    <button @onclick="() => ToggleAsync(s.Id)" title="@L["Subs.Expand.Tip"]" style="border:0; background:none; cursor:pointer; font-size:.9rem;">@(_expanded.ContainsKey(s.Id) ? "▾" : "▸")</button>
                </td>
                <td style="padding:.4rem;">@s.CustomerEmail</td>
                <td title="@(s.StorefrontId?.ToString() ?? "")">@StorefrontLabel(s.StorefrontId)</td>
                <td title="@s.ProductId">@ProductLabel(s.ProductId)</td>
                <td><span style="color:@StatusColor(s.Status); font-weight:600;">@StatusLabel(s.Status)</span></td>
                <td>@BillingLabel(s.BillingPeriod)</td>
                <td>@Period(s.CurrentPeriodStart, s.CurrentPeriodEnd)</td>
                <td>@Money.WithCode(s.PriceMinor, s.Currency)</td>
                <td>@s.CreatedAt.LocalDateTime.ToString("dd MMM yyyy")</td>
                <td>
                    @if (_acted.Contains(s.Id))
                    {
                        <span style="color:#6b7280;">@L["Subs.Updating"]</span>
                    }
                    else
                    {
                        <button disabled="@_busy" @onclick="() => RenewRow(s.Id)" title="@L["Subs.Renew.Tip"]">@L["Subs.Renew"]</button>
                        @if (s.Status != "Cancelled")
                        {
                            <button disabled="@_busy" @onclick="() => CancelRow(s.Id)" title="@L["Subs.Cancel.Tip"]" style="color:#b91c1c;">@L["Subs.Cancel"]</button>
                        }
                    }
                </td>
            </tr>
            @if (_expanded.TryGetValue(s.Id, out var detail))
            {
                <tr><td></td><td colspan="9" style="padding:.4rem .4rem 1.2rem;">
                    @if (detail is null)
                    {
                        <p style="color:#6b7280;">@L["Common.Loading"]</p>
                    }
                    else
                    {
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem; max-width:820px;">
                            <section style="border:1px solid #e5e7eb; border-radius:8px; padding:.8rem; background:#fff;">
                                <h3 style="margin:0 0 .5rem; font-size:.95rem;">@L["Subs.Detail.Subscriber"]</h3>
                                <dl style="margin:0; font-size:.85rem; display:grid; grid-template-columns:auto 1fr; gap:.2rem .6rem;">
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Email"]</dt><dd style="margin:0;">@detail.CustomerEmail</dd>
                                    <dt style="color:#6b7280;">@L["Fin.Col.Storefront"]</dt><dd style="margin:0;">@StorefrontLabel(detail.StorefrontId)</dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Tenant"]</dt><dd style="margin:0;"><code>@detail.TenantId</code></dd>
                                </dl>
                            </section>
                            <section style="border:1px solid #e5e7eb; border-radius:8px; padding:.8rem; background:#fff;">
                                <h3 style="margin:0 0 .5rem; font-size:.95rem;">@L["Subs.Detail.Subscription"]</h3>
                                <dl style="margin:0; font-size:.85rem; display:grid; grid-template-columns:auto 1fr; gap:.2rem .6rem;">
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Id"]</dt><dd style="margin:0;"><code>@detail.Id</code></dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.OrderId"]</dt><dd style="margin:0;"><code>@detail.OrderId</code></dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Product"]</dt><dd style="margin:0;"><code>@detail.ProductId</code></dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Variant"]</dt><dd style="margin:0;"><code>@(detail.VariantId?.ToString() ?? "—")</code></dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Price"]</dt><dd style="margin:0;">@Money.WithCode(detail.PriceMinor, detail.Currency) · @BillingLabel(detail.BillingPeriod)</dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Status"]</dt><dd style="margin:0;"><span style="color:@StatusColor(detail.Status); font-weight:600;">@StatusLabel(detail.Status)</span></dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Created"]</dt><dd style="margin:0;">@detail.CreatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</dd>
                                    <dt style="color:#6b7280;">@L["Subs.Detail.Updated"]</dt><dd style="margin:0;">@detail.UpdatedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</dd>
                                </dl>
                            </section>
                        </div>
                        <section style="margin-top:1rem; max-width:1040px;">
                            <h3 style="margin:0 0 .5rem; font-size:.95rem;">@L["Subs.Detail.History"]</h3>
                            @if (detail.Renewals.Count == 0)
                            {
                                <p style="color:#9ca3af; font-size:.85rem;">@L["Subs.History.Empty"]</p>
                            }
                            else
                            {
                                <table style="border-collapse:collapse; font-size:.83rem; width:100%;">
                                    <thead><tr style="text-align:left; border-bottom:1px solid #e5e7eb; color:#6b7280;">
                                        <th style="padding:.3rem;">@L["Subs.History.Seq"]</th>
                                        <th>@L["Subs.History.Period"]</th>
                                        <th>@L["Subs.History.Amount"]</th>
                                        <th>@L["Subs.History.Recorded"]</th>
                                        <th title="@L["Subs.History.Charge.Tip"]">@L["Subs.History.Charge"]</th>
                                        <th title="@L["Subs.History.Refunds.Tip"]">@L["Subs.History.Refunds"]</th>
                                        <th>@L["Common.Actions"]</th>
                                    </tr></thead>
                                    <tbody>
                                    @foreach (var r in detail.Renewals)
                                    {
                                        <tr style="border-bottom:1px solid #f3f4f6;" data-charge="@(r.ChargeReference ?? "")">
                                            <td style="padding:.3rem;">#@r.Sequence</td>
                                            <td>@Period(r.PeriodStart, r.PeriodEnd)</td>
                                            <td>@Money.WithCode(r.AmountMinor, r.Currency)</td>
                                            <td>@r.RecordedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                                            <td>
                                                @if (r.ChargeReference is { } reference)
                                                {
                                                    <code title="@L["Subs.Charge.Reference.Tip", reference, r.PaymentIntentId ?? "—"]" style="font-size:.75rem;">@ShortReference(reference)</code>
                                                }
                                                else
                                                {
                                                    <span title="@(r.Sequence == 1 ? L["Subs.Charge.ByOrder.Tip"] : L["Subs.Charge.None.Tip"])" style="color:#9ca3af;">@(r.Sequence == 1 ? L["Subs.Charge.ByOrder"] : "—")</span>
                                                }
                                            </td>
                                            <td>
                                                @if (r.ChargeReference is not null)
                                                {
                                                    var state = ChargeState(r);
                                                    <span title="@ChargeStateTip(r, state)" style="display:inline-block; padding:.05rem .4rem; border-radius:999px; font-size:.7rem; font-weight:600; color:@ChargeStateColor(state); background:@ChargeStateBackground(state);">@ChargeStateLabel(state)</span>
                                                    @if (r.RefundedMinor is > 0 && state != ChargeRefundState.Refunded)
                                                    {
                                                        <span style="margin-left:.3rem; color:#6b7280;">@L["Subs.Charge.RefundedSoFar", Money.WithCode(r.RefundedMinor.Value, r.Currency)]</span>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @if (r.ChargeReference is { } chargeRef && Refundable(r))
                                                {
                                                    if (_refundPending.Contains(chargeRef))
                                                    {
                                                        <span style="color:#6b7280;" title="@L["Subs.Refund.Pending.Tip"]">@L["Subs.Refund.Pending"]</span>
                                                    }
                                                    else if (_refundForm?.ChargeReference != chargeRef)
                                                    {
                                                        <button disabled="@_busy" @onclick="() => OpenRefund(detail, r)" title="@L["Subs.Refund.Tip"]">@L["Subs.Refund"]</button>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                        @if (_refundForm is { } form && form.ChargeReference == r.ChargeReference)
                                        {
                                            <tr style="background:#f9fafb;"><td colspan="7" class="charge-refund-form" style="padding:.6rem .5rem;">
                                                <div style="display:flex; gap:.6rem; align-items:end; flex-wrap:wrap;">
                                                    <label style="font-size:.8rem; color:#6b7280;">@L["Subs.Refund.Amount", form.Currency]<br />
                                                        <input type="number" min="@AmountStep(form.Currency)" max="@Money.ToMajor(form.RemainingMinor, form.Currency).ToString(System.Globalization.CultureInfo.InvariantCulture)" step="@AmountStep(form.Currency)"
                                                               @bind="form.Amount" @bind:after="ResetRefundConfirm" disabled="@_busy"
                                                               title="@L["Subs.Refund.Amount.Tip", Money.WithCode(form.RemainingMinor, form.Currency)]" style="width:8rem; padding:.3rem;" />
                                                    </label>
                                                    <label style="font-size:.8rem; color:#6b7280;">@L["Subs.Refund.Reason"]<br />
                                                        <input type="text" maxlength="200" @bind="form.Reason" @bind:after="ResetRefundConfirm" disabled="@_busy"
                                                               title="@L["Subs.Refund.Reason.Tip"]" style="width:18rem; padding:.3rem;" />
                                                    </label>
                                                    <button disabled="@_busy" @onclick="() => SubmitRefundAsync(detail.OrderId)" title="@L["Subs.Refund.Submit.Tip"]"
                                                            style="color:#b91c1c;">@(form.Confirming ? L["Subs.Refund.Confirm", Money.WithCode(Money.ToMinor(form.Amount, form.Currency), form.Currency)] : L["Subs.Refund.Submit"])</button>
                                                    <button disabled="@_busy" @onclick="CloseRefund" title="@L["Subs.Refund.Close.Tip"]">@L["Common.Cancel"]</button>
                                                </div>
                                                @if (form.Error is not null) { <p role="alert" style="color:#b91c1c; margin:.4rem 0 0; font-size:.8rem;">@form.Error</p> }
                                            </td></tr>
                                        }
                                    }
                                    </tbody>
                                </table>
                            }
                        </section>
                    }
                </td></tr>
            }
        }
        </tbody>
    </table>
    @if (Filtered.Count == 0) { <p style="color:#9ca3af;">@L["Subs.Empty"]</p> }
}

@code {
    // The subscription endpoints carry no tenant, so they fall back to the configured default tenant —
    // the same one Mission Control and the RMA queue read.
    private const string TenantId = "00000000-0000-0000-0000-000000000001";

    private List<SubscriptionDto>? _subs;
    // ProductId → title, loaded from the Catalog admin list so the table shows names, not GUIDs.
    private Dictionary<Guid, string> _productTitles = [];
    // StorefrontId → name, loaded from Catalog so the table shows the store name, not a GUID.
    private Dictionary<Guid, string> _storefrontNames = [];
    private string _filter = "";
    private bool _busy;
    private string? _error;
    private string? _status;
    // Expanded rows → their lazily-loaded detail (null while the fetch is in flight).
    private readonly Dictionary<Guid, SubscriptionDetailDto?> _expanded = [];
    // Rows whose renew/cancel was accepted; buttons stay suppressed until the next reload (mirrors the
    // eventually-consistent guard the RMA queue uses against a double-click landing a stale-state error).
    private readonly HashSet<Guid> _acted = [];
    // The one open renewal-charge refund form (admin_recurring_charge_refund_action), and the charges whose refund was
    // accepted (202) but has not yet shown in the detail — their Refund button stays suppressed until the next reload.
    private RefundForm? _refundForm;
    private readonly HashSet<string> _refundPending = [];

    private List<SubscriptionDto> Filtered =>
        (_subs ?? []).Where(s => _filter.Length == 0 || s.Status == _filter).ToList();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = _status = null;
        try
        {
            _subs = await Gateway.GetListAsync<SubscriptionDto>($"/api/payments/admin/subscriptions/?tenantId={TenantId}");
            // Resolve storefront names by id (Catalog owns them) so the table reads store names, not GUIDs.
            // Best-effort: a failed lookup leaves the short id and must never blank the page.
            if (_storefrontNames.Count == 0)
            {
                try
                {
                    var stores = await Gateway.GetListAsync<StorefrontRow>($"/api/catalog/admin/storefronts?tenantId={TenantId}");
                    _storefrontNames = stores.ToDictionary(x => x.Id, x => x.Name);
                }
                catch { /* leave unresolved; StorefrontLabel falls back to the short id */ }
            }
            // Resolve product titles by id (Catalog owns them) so the table reads names, not GUIDs.
            // Fetch only the distinct products actually referenced — the admin list is paged (~200) and
            // would miss these, and there are only a handful of subscribed products. Best-effort per id:
            // a failed lookup just leaves the short id, and must never blank the page.
            foreach (var pid in _subs.Select(s => s.ProductId).Distinct().Where(p => !_productTitles.ContainsKey(p)))
            {
                try
                {
                    var product = await Gateway.GetAsync<ProductRow>($"/api/catalog/admin/products/{pid}");
                    if (product is not null) { _productTitles[pid] = product.Title; }
                }
                catch { /* leave unresolved; ProductLabel falls back to the short id */ }
            }
            _acted.Clear();
            _refundPending.Clear();
            // Refresh any open detail panel so its history reflects a renewal just performed.
            foreach (var id in _expanded.Keys.ToList())
            {
                _expanded[id] = await Gateway.GetAsync<SubscriptionDetailDto>($"/api/payments/admin/subscriptions/{id}?tenantId={TenantId}");
            }
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ToggleAsync(Guid id)
    {
        if (_expanded.Remove(id))
        {
            return;
        }

        _expanded[id] = null; // show the loading state, then fetch the detail + history lazily
        _expanded[id] = await Gateway.GetAsync<SubscriptionDetailDto>($"/api/payments/admin/subscriptions/{id}?tenantId={TenantId}");
    }

    private Task RenewRow(Guid id) => ActAsync(id, "renew", L["Subs.Msg.Renewed"]);
    private Task CancelRow(Guid id) => ActAsync(id, "cancel", L["Subs.Msg.Cancelled"]);

    private async Task ActAsync(Guid id, string action, string okMessage)
    {
        _error = _status = null;
        _busy = true;
        var response = await Gateway.PostAsync(
            $"/api/payments/admin/subscriptions/{id}/{action}?tenantId={TenantId}", idempotencyKey: $"{action}-{id}");
        if (response.IsSuccessStatusCode)
        {
            _acted.Add(id);
            await LoadAsync(); // clears _acted, then re-reads the row (and any open history) in its new state
            _status = okMessage;
        }
        else
        {
            _error = L["Subs.Msg.Failed", action, (int)response.StatusCode, await GatewayError.ReadAsync(response)];
        }

        _busy = false;
    }

    // ── Refunding a renewal's own charge (admin_recurring_charge_refund_action) ──────────────────────────────────────
    // POST /admin/refunds with the charge's chargeReference (renewal_usage_refund_path): the single refund consumer
    // refunds that charge's intent and reverses its own tax. Period 1 has no reference — the order paid it, so it is
    // refunded from the Orders page. Same safeguards as the order refund: an explicit confirm step, an Idempotency-Key,
    // the button disabled while the request is in flight, then the charge's state re-read from the server.

    // PaymentStatus crosses as a NUMBER (Payments' enum): 2 Succeeded, 4 Refunded, 5 Disputed, 6 Chargeback.
    private const int PaymentSucceeded = 2, PaymentRefunded = 4, PaymentDisputed = 5, PaymentChargeback = 6;

    private enum ChargeRefundState { NotRefunded, PartiallyRefunded, Refunded, Disputed }

    private static long Remaining(RenewalDto r) => Math.Max(0, r.AmountMinor - (r.RefundedMinor ?? 0));

    private static ChargeRefundState ChargeState(RenewalDto r) => r.PaymentStatus switch
    {
        PaymentDisputed or PaymentChargeback => ChargeRefundState.Disputed,
        PaymentRefunded => ChargeRefundState.Refunded,
        _ when r.RefundedMinor is > 0 && Remaining(r) == 0 => ChargeRefundState.Refunded,
        _ when r.RefundedMinor is > 0 => ChargeRefundState.PartiallyRefunded,
        _ => ChargeRefundState.NotRefunded,
    };

    // Only a settled, undisputed charge with money left on it is refundable — the rule the refund consumer enforces
    // (a captured payment, amount ≤ what is left); a disputed charge is returned through its dispute instead.
    private static bool Refundable(RenewalDto r) => r.PaymentStatus == PaymentSucceeded && Remaining(r) > 0;

    private string ChargeStateLabel(ChargeRefundState state) => state switch
    {
        ChargeRefundState.Refunded => L["Subs.Charge.Refunded"],
        ChargeRefundState.PartiallyRefunded => L["Subs.Charge.PartiallyRefunded"],
        ChargeRefundState.Disputed => L["Subs.Charge.Disputed"],
        _ => L["Subs.Charge.NotRefunded"],
    };

    private string ChargeStateTip(RenewalDto r, ChargeRefundState state) => state switch
    {
        ChargeRefundState.Refunded => L["Subs.Charge.Refunded.Tip", Money.WithCode(r.RefundedMinor ?? r.AmountMinor, r.Currency)],
        ChargeRefundState.PartiallyRefunded => L["Subs.Charge.PartiallyRefunded.Tip",
            Money.WithCode(r.RefundedMinor ?? 0, r.Currency), Money.WithCode(r.AmountMinor, r.Currency), Money.WithCode(Remaining(r), r.Currency)],
        ChargeRefundState.Disputed => L["Subs.Charge.Disputed.Tip"],
        _ => L["Subs.Charge.NotRefunded.Tip"],
    };

    private static string ChargeStateColor(ChargeRefundState state) => state switch
    {
        ChargeRefundState.Refunded => "#374151",
        ChargeRefundState.PartiallyRefunded => "#b45309",
        ChargeRefundState.Disputed => "#b91c1c",
        _ => "#047857",
    };

    private static string ChargeStateBackground(ChargeRefundState state) => state switch
    {
        ChargeRefundState.Refunded => "#e5e7eb",
        ChargeRefundState.PartiallyRefunded => "#fef3c7",
        ChargeRefundState.Disputed => "#fee2e2",
        _ => "#d1fae5",
    };

    // renew-{subscription id}-{sequence} is long; show its head and tail (the full reference is in the tooltip).
    private static string ShortReference(string reference) =>
        reference.Length <= 22 ? reference : $"{reference[..14]}…{reference[^6..]}";

    // The input's step + minimum: one minor unit at the currency's decimals (0.01 USD, 1 JPY, 0.001 KWD).
    private static string AmountStep(string currency) =>
        Money.Digits(currency) == 0 ? "1" : "0." + new string('0', Money.Digits(currency) - 1) + "1";

    private void OpenRefund(SubscriptionDetailDto detail, RenewalDto r)
    {
        _error = _status = null;
        _refundForm = new RefundForm
        {
            SubscriptionId = detail.Id,
            ChargeReference = r.ChargeReference!,
            Currency = r.Currency,
            RemainingMinor = Remaining(r),
            RefundedBeforeMinor = r.RefundedMinor ?? 0,
            Amount = Money.ToMajor(Remaining(r), r.Currency), // defaults to a full refund of what is left
        };
    }

    private void CloseRefund() => _refundForm = null;

    // Any edit re-arms the confirm step and takes a fresh Idempotency-Key — the key guards one confirmed request, and
    // the server answers a reused key with a different body as a 409 conflict.
    private void ResetRefundConfirm()
    {
        if (_refundForm is { } form)
        {
            form.Confirming = false;
            form.IdempotencyKey = RefundForm.NewKey();
        }
    }

    private async Task SubmitRefundAsync(Guid orderId)
    {
        if (_refundForm is not { } form)
        {
            return;
        }

        form.Error = null;
        var amountMinor = Money.ToMinor(form.Amount, form.Currency);
        if (amountMinor <= 0 || amountMinor > form.RemainingMinor)
        {
            form.Confirming = false;
            form.Error = L["Subs.Refund.AmountInvalid", Money.WithCode(form.RemainingMinor, form.Currency)];
            return;
        }

        if (string.IsNullOrWhiteSpace(form.Reason))
        {
            form.Confirming = false;
            form.Error = L["Subs.Refund.ReasonRequired"];
            return;
        }

        if (!form.Confirming)
        {
            form.Confirming = true; // first click arms; the button now reads "Confirm refund of …"
            return;
        }

        _error = _status = null;
        _busy = true;
        try
        {
            // orderId pins the charge to this subscription's order: the consumer refuses a reference of another order.
            var response = await Gateway.PostAsync(
                "/api/payments/admin/refunds",
                new { orderId, amountMinor, reason = form.Reason.Trim(), chargeReference = form.ChargeReference },
                idempotencyKey: form.IdempotencyKey);
            if (!response.IsSuccessStatusCode)
            {
                form.Confirming = false;
                form.Error = L["Subs.Refund.Failed", (int)response.StatusCode, await GatewayError.ReadAsync(response)];
                return;
            }

            _refundForm = null;
            _refundPending.Add(form.ChargeReference);
            _status = L["Subs.Refund.Requested", Money.WithCode(amountMinor, form.Currency), form.ChargeReference];
            await AwaitRefundAsync(form.SubscriptionId, form.ChargeReference, form.RefundedBeforeMinor, amountMinor, form.Currency);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // The refund is executed asynchronously (202 → RefundRequested → the refund consumer), so re-read the detail until the
    // charge shows the refund — usually well under a second — and render that state. If it has not landed after a few
    // seconds, say so and leave the button suppressed; Refresh re-reads it (a declined refund leaves the charge as it was).
    private async Task AwaitRefundAsync(Guid subscriptionId, string chargeReference, long refundedBefore, long amountMinor, string currency)
    {
        for (var attempt = 0; attempt < 12; attempt++)
        {
            await Task.Delay(500);
            var detail = await Gateway.GetAsync<SubscriptionDetailDto>($"/api/payments/admin/subscriptions/{subscriptionId}?tenantId={TenantId}");
            if (detail is null)
            {
                return;
            }

            if (_expanded.ContainsKey(subscriptionId))
            {
                _expanded[subscriptionId] = detail;
            }

            if (detail.Renewals.FirstOrDefault(x => x.ChargeReference == chargeReference) is { } charge && (charge.RefundedMinor ?? 0) > refundedBefore)
            {
                _refundPending.Remove(chargeReference);
                _status = L["Subs.Refund.Done", Money.WithCode(amountMinor, currency), chargeReference];
                return;
            }
        }

        _status = L["Subs.Refund.NotYet", chargeReference];
    }

    private sealed class RefundForm
    {
        public required Guid SubscriptionId { get; init; }
        public required string ChargeReference { get; init; }
        public required string Currency { get; init; }
        public required long RemainingMinor { get; init; }
        public required long RefundedBeforeMinor { get; init; }
        public decimal Amount { get; set; }
        public string Reason { get; set; } = "";
        public bool Confirming { get; set; }
        public string? Error { get; set; }
        public string IdempotencyKey { get; set; } = NewKey();

        public static string NewKey() => $"charge-refund-{Guid.CreateVersion7():N}";
    }

    private string Short(Guid id) => id.ToString()[..8];
    // The product's title when Catalog resolved it, else the short id (the full id is in the cell tooltip).
    private string ProductLabel(Guid id) => _productTitles.TryGetValue(id, out var title) ? title : Short(id);
    // The storefront's name when Catalog resolved it, else the short id; "—" when the sub carries no store
    // (legacy subscriptions from before StorefrontId was threaded through SubscriptionRequested, #210).
    private string StorefrontLabel(Guid? id) =>
        id is not { } sid ? "—" : _storefrontNames.TryGetValue(sid, out var name) ? name : Short(sid);
    private string Period(DateTimeOffset start, DateTimeOffset end) =>
        $"{start.LocalDateTime:dd MMM yyyy} – {end.LocalDateTime:dd MMM yyyy}";

    // Status carries the enum NAME over the wire; colour and localize it for the operator.
    private static string StatusColor(string status) => status switch
    {
        "Active" or "Trialing" => "#059669",
        "PastDue" => "#b45309",
        _ => "#6b7280",
    };

    private string StatusLabel(string status) => status switch
    {
        "Active" => L["Subs.Status.Active"],
        "Trialing" => L["Subs.Status.Trialing"],
        "PastDue" => L["Subs.Status.PastDue"],
        "Cancelled" => L["Subs.Status.Cancelled"],
        _ => status,
    };

    // The domain has only Once/Monthly/Yearly; render friendly localized labels for the real values.
    // Other cadences (e.g. Weekly) would need a domain enum + Advance() change, out of scope here.
    private string BillingLabel(string period) => period switch
    {
        "Monthly" => L["Subs.Billing.Monthly"],
        "Yearly" => L["Subs.Billing.Yearly"],
        "Once" => L["Subs.Billing.Once"],
        _ => period,
    };

    private record SubscriptionDto(
        Guid Id, Guid OrderId, Guid? StorefrontId, string CustomerEmail, Guid ProductId, Guid? VariantId, string BillingPeriod, long PriceMinor,
        string Currency, string Status, DateTimeOffset CurrentPeriodStart, DateTimeOffset CurrentPeriodEnd, DateTimeOffset CreatedAt, DateTimeOffset UpdatedAt);

    // Minimal projection of Catalog's admin product list — only what the Product column needs.
    private record ProductRow(Guid Id, string Title);

    // Minimal projection of Catalog's admin storefront list — only what the Storefront column needs.
    private record StorefrontRow(Guid Id, string Name);

    // A settled renewal (period 2 on) carries its own payment (renewal_usage_refund_path): the chargeReference POST
    // /admin/refunds names, how much is already refunded, and the payment's status (a number). Null for period 1 (the
    // order paid it) and for renewals settled before payments were recorded per charge.
    private record RenewalDto(
        int Sequence, DateTimeOffset PeriodStart, DateTimeOffset PeriodEnd, long AmountMinor, string Currency, DateTimeOffset RecordedAt,
        string? ChargeReference = null, string? PaymentIntentId = null, long? TaxMinor = null, long? RefundedMinor = null,
        int? PaymentStatus = null, int? DisputeStatus = null);

    private record SubscriptionDetailDto(
        Guid Id, Guid TenantId, Guid OrderId, Guid? StorefrontId, string CustomerEmail, Guid ProductId, Guid? VariantId, string BillingPeriod, long PriceMinor,
        string Currency, string Status, DateTimeOffset CurrentPeriodStart, DateTimeOffset CurrentPeriodEnd, DateTimeOffset CreatedAt,
        DateTimeOffset UpdatedAt, IReadOnlyList<RenewalDto> Renewals);
}
