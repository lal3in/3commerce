@page "/orders"
@attribute [Authorize(Roles = "admin")]
@inject GatewayClient Gateway
@rendermode AdminRenderModes.InteractiveServerNoPrerender

<h1>@L["Orders.Title"]</h1>
<p style="color:#6b7280;">@L["Orders.Intro"]</p>

<div style="display:flex; gap:.6rem; align-items:end; flex-wrap:wrap; margin:.4rem 0 1rem;">
    <label style="font-size:.8rem; color:#6b7280;">@L["Orders.Filter.From"]<br />
        <input type="date" @bind="_start" style="padding:.35rem;" title="@L["Orders.Filter.From.Tip"]" /></label>
    <label style="font-size:.8rem; color:#6b7280;">@L["Orders.Filter.To"]<br />
        <input type="date" @bind="_end" style="padding:.35rem;" title="@L["Orders.Filter.To.Tip"]" /></label>
    <label style="font-size:.8rem; color:#6b7280;">@L["Orders.Filter.Storefront"]<br />
        <select @bind="_storefrontId" style="padding:.35rem; min-width:12rem;" title="@L["Orders.Filter.Storefront.Tip"]">
            <option value="">@L["Orders.Filter.AllStorefronts"]</option>
            @if (_storefronts is not null)
            {
                @foreach (var s in _storefronts)
                {
                    <option value="@s.Id">@s.Name (@s.Currency)</option>
                }
            }
        </select></label>
    <label style="font-size:.8rem; color:#6b7280;">@L["Orders.Filter.Status"]<br />
        <select @bind="_statusFilter" style="padding:.35rem;" title="@L["Orders.Filter.Status.Tip"]">
            <option value="">@L["Orders.Filter.AllStatuses"]</option>
            @foreach (var st in StatusOptions)
            {
                <option value="@st">@st</option>
            }
        </select></label>
    <label style="font-size:.8rem; color:#6b7280;">@L["Orders.Filter.Product"]<br />
        <input @bind="_product" @bind:event="oninput" @onkeydown="OnProductKeyDown" placeholder="@L["Orders.Filter.Product.Placeholder"]" style="padding:.35rem; min-width:14rem;" title="@L["Orders.Filter.Product.Tip"]" /></label>
    <button @onclick="ApplyFilters" disabled="@_loading" style="padding:.4rem .9rem;">@L["Orders.Filter.Apply"]</button>
    <button @onclick="ClearFilters" disabled="@_loading" title="@L["Orders.Filter.Clear.Tip"]" style="padding:.4rem .9rem;">@L["Orders.Filter.Clear"]</button>
</div>

@if (_error is not null)
{
    <p style="color:#b91c1c;">@_error</p>
}
@if (_status is not null)
{
    <p style="color:#047857;">@_status</p>
}

@if (_orders is null)
{
    <p>@L["Common.Loading"]</p>
}
else if (_orders.Count == 0)
{
    <p>@L["Orders.Empty"]</p>
}
else
{
    <table style="border-collapse:collapse;width:100%;">
        <thead><tr><th style="text-align:left;">@L["Orders.Col.Order"]</th><th style="text-align:left;">@L["Orders.Col.Storefront"]</th><th>@L["Common.Status"]</th><th>@L["Orders.Col.Total"]</th><th title="@L["Orders.Col.Payment.Tip"]">@L["Orders.Col.Payment"]</th><th>@L["Orders.Col.Placed"]</th><th>@L["Common.Actions"]</th></tr></thead>
        <tbody>
        @foreach (var o in _orders)
        {
            <tr style="border-top:1px solid #e5e7eb;">
                <td style="font-family:monospace;">
                    <button @onclick="() => ToggleDetails(o.Id)" title="@L["Orders.Details.Tip"]" style="background:none;border:0;cursor:pointer;font:inherit;color:inherit;">
                        <span aria-hidden style="color:#9ca3af;">@(_expanded.Contains(o.Id) ? "▾" : "▸")</span> @o.Id
                    </button>
                </td>
                <td>@StorefrontName(o)</td>
                <td>
                    @o.Status
                    @if (o.PartiallyRefunded && o.Status == "Confirmed")
                    {
                        <span title="@L["Orders.Badge.PartiallyRefunded.Tip"]" style="display:inline-block; margin-left:.4rem; padding:.05rem .4rem; border-radius:999px; font-size:.7rem; font-weight:600; color:#b45309; background:#fef3c7;">@L["Orders.Badge.PartiallyRefunded"]</span>
                    }
                    @if (o.Disputed)
                    {
                        <span title="@L["Orders.Badge.Disputed.Tip"]" style="display:inline-block; margin-left:.4rem; padding:.05rem .4rem; border-radius:999px; font-size:.7rem; font-weight:600; color:#b91c1c; background:#fee2e2;">@L["Orders.Badge.Disputed"]</span>
                    }
                </td>
                <td>@Money.WithCode(o.GrossMinor, o.Currency)</td>
                <td>@PaymentLabel(o.PaymentOption)</td>
                <td>@o.CreatedAt.LocalDateTime.ToString("g")</td>
                <td>
                    @if (o.Status is "Pending" or "AwaitingPayment")
                    {
                        <button @onclick="() => Cancel(o.Id)" title="@L["Orders.Cancel.Tip"]">@(_confirm == $"{o.Id}:cancel" ? L["Common.Confirm"] : L["Orders.Cancel"])</button>
                    }
                    else if (o.Status == "Confirmed")
                    {
                        <button @onclick="() => Refund(o)" title="@L["Orders.Refund.Tip"]">@(_confirm == $"{o.Id}:refund" ? L["Common.Confirm"] : L["Orders.Refund"])</button>
                        <button @onclick="() => Return(o)" title="@L["Orders.Return.Tip"]">@(_confirm == $"{o.Id}:return" ? L["Common.Confirm"] : L["Orders.Return"])</button>
                    }
                </td>
            </tr>
            @if (_expanded.Contains(o.Id))
            {
                <tr style="background:#f9fafb;"><td colspan="7" style="padding:.7rem .9rem;">
                    @if (!_details.TryGetValue(o.Id, out var d))
                    {
                        <p style="color:#6b7280;">@L["Common.Loading"]</p>
                    }
                    else if (d is null)
                    {
                        <p style="color:#b45309;">@L["Orders.Details.Unavailable"]</p>
                    }
                    else
                    {
                        <div style="display:flex; flex-wrap:wrap; gap:1.5rem; font-size:.85rem;">
                            <div style="min-width:15rem;">
                                <div style="font-weight:600; margin-bottom:.3rem;">@L["Orders.Details.Summary"]</div>
                                <div>@L["Orders.Details.Number"]: <strong>#@d.PublicOrderNumber</strong></div>
                                <div>@L["Orders.Details.Date"]: @d.CreatedAt.LocalDateTime.ToString("g")</div>
                                <div>@L["Common.Status"]: @d.Status@(d.PartiallyRefunded ? $" · {L["Orders.Badge.PartiallyRefunded"]}" : "")@(d.Disputed ? $" · {L["Orders.Badge.Disputed"]}" : "")</div>
                                <div>@L["Orders.Details.Email"]: @d.Email</div>
                                <div>@L["Orders.Details.Payment"]: @PaymentLabel(d.PaymentOption)@(string.IsNullOrEmpty(d.PaymentInstrumentSummary) ? "" : $" · {d.PaymentInstrumentSummary}") (@d.PaymentProvider)</div>
                            </div>
                            @if (d.ShippingAddress is not null)
                            {
                                <div style="min-width:12rem;">
                                    <div style="font-weight:600; margin-bottom:.3rem;">@L["Orders.Details.ShipTo"]</div>
                                    <div>@d.ShippingAddress.Name</div>
                                    <div>@d.ShippingAddress.Line1</div>
                                    <div>@d.ShippingAddress.City @d.ShippingAddress.Postcode, @d.ShippingAddress.Country</div>
                                </div>
                            }
                            <div style="flex:1; min-width:18rem;">
                                <div style="font-weight:600; margin-bottom:.3rem;">@L["Orders.Details.Items"]</div>
                                <table style="border-collapse:collapse; width:100%;">
                                    <tbody>
                                    @foreach (var l in d.Lines)
                                    {
                                        <tr style="border-top:1px solid #f3f4f6;">
                                            <td style="text-align:right; padding:.15rem .4rem; color:#6b7280;">@l.Quantity×</td>
                                            <td style="padding:.15rem .4rem;">@l.Title@(string.IsNullOrEmpty(l.VariantSku) ? "" : $" ({l.VariantSku})")</td>
                                            <td style="text-align:right; padding:.15rem .4rem;">@Money.WithCode(l.UnitPriceMinor, d.Currency)</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                                <table style="border-collapse:collapse; width:100%; margin-top:.4rem; border-top:1px solid #e5e7eb;">
                                    <tbody>
                                        <tr><td style="padding:.1rem .4rem; color:#6b7280;">@L["Orders.Details.Subtotal"]</td><td style="text-align:right; padding:.1rem .4rem;">@Money.WithCode(d.NetMinor, d.Currency)</td></tr>
                                        @if (d.DiscountMinor > 0)
                                        {
                                            <tr><td style="padding:.1rem .4rem; color:#6b7280;">@L["Orders.Details.Discount"]</td><td style="text-align:right; padding:.1rem .4rem;">−@Money.WithCode(d.DiscountMinor, d.Currency)</td></tr>
                                        }
                                        <tr><td style="padding:.1rem .4rem; color:#6b7280;">@L["Orders.Details.Shipping"]</td><td style="text-align:right; padding:.1rem .4rem;">@Money.WithCode(d.ShippingMinor, d.Currency)</td></tr>
                                        <tr><td style="padding:.1rem .4rem; color:#6b7280;">@L["Orders.Details.Tax"]</td><td style="text-align:right; padding:.1rem .4rem;">@Money.WithCode(d.TaxMinor, d.Currency)</td></tr>
                                        <tr><td style="padding:.1rem .4rem; font-weight:600;">@L["Orders.Details.Total"]</td><td style="text-align:right; padding:.1rem .4rem; font-weight:600;">@Money.WithCode(d.GrossMinor, d.Currency)</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </td></tr>
            }
        }
        </tbody>
    </table>
}

@code {
    private const string Tenant = "00000000-0000-0000-0000-000000000001";
    private List<OrderDto>? _orders;
    private List<StorefrontDto>? _storefronts;
    private string? _status;
    private string? _error;
    private string? _confirm;
    private bool _loading;
    // Filters (server-side — the endpoint caps at 200 rows, so filtering the full set on the server is what
    // makes the filter meaningful).
    private DateOnly? _start;
    private DateOnly? _end;
    private string _storefrontId = "";
    private string _statusFilter = "";
    private string _product = "";

    // Expanded rows + their fetched detail (null value = fetch failed → "unavailable"; missing key = loading).
    private readonly HashSet<Guid> _expanded = [];
    private readonly Dictionary<Guid, OrderDetailDto?> _details = [];

    protected override async Task OnInitializedAsync()
    {
        _storefronts = await SafeStorefronts();
        await LoadAsync();
    }

    private async Task<List<StorefrontDto>> SafeStorefronts()
    {
        try { return await Gateway.GetListAsync<StorefrontDto>($"/api/catalog/admin/storefronts?tenantId={Tenant}"); }
        catch { return []; }
    }

    // The storefront an order belongs to, resolved to its name; a synthetic/default or unknown store shows "—".
    private string StorefrontName(OrderDto o) =>
        o.StorefrontId is { } sid ? _storefronts?.FirstOrDefault(s => s.Id == sid)?.Name ?? "—" : "—";

    private async Task ToggleDetails(Guid id)
    {
        if (!_expanded.Remove(id))
        {
            _expanded.Add(id);
            if (!_details.ContainsKey(id))
            {
                _details[id] = await Gateway.GetAsync<OrderDetailDto>($"/api/ordering/admin/orders/{id}");
            }
        }
    }

    private async Task LoadAsync()
    {
        _error = _status = null;
        _confirm = null;
        _loading = true;
        var q = new List<string>();
        if (_start is { } s) { q.Add($"start={s:yyyy-MM-dd}"); }
        if (_end is { } e) { q.Add($"end={e:yyyy-MM-dd}"); }
        if (!string.IsNullOrEmpty(_storefrontId)) { q.Add($"storefrontId={_storefrontId}"); }
        if (!string.IsNullOrEmpty(_statusFilter)) { q.Add($"status={Uri.EscapeDataString(_statusFilter)}"); }
        if (!string.IsNullOrWhiteSpace(_product)) { q.Add($"product={Uri.EscapeDataString(_product.Trim())}"); }
        var url = "/api/ordering/admin/orders" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
        _orders = await Gateway.GetListAsync<OrderDto>(url);
        _loading = false;
    }

    private Task ApplyFilters() => LoadAsync();

    private async Task OnProductKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadAsync();
        }
    }

    private async Task ClearFilters()
    {
        _start = _end = null;
        _storefrontId = _statusFilter = _product = "";
        await LoadAsync();
    }

    private async Task Cancel(Guid id)
    {
        if (_confirm != $"{id}:cancel") { _confirm = $"{id}:cancel"; return; }
        _confirm = null;
        var response = await Gateway.PostAsync($"/api/ordering/admin/orders/{id}/cancel", new { reason = "cancelled by admin" });
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
            _status = L["Orders.Status.Cancelled"]; // after LoadAsync — it clears _status on refresh
        }
        else
        {
            _error = await response.Content.ReadAsStringAsync();
        }
    }

    private async Task Refund(OrderDto o)
    {
        if (_confirm != $"{o.Id}:refund") { _confirm = $"{o.Id}:refund"; return; }
        _confirm = null;
        // Refund through the RMA path (auto-approved, no-return) so it shows in the RMA queue and drives
        // the single refund flow; when the payment is fully refunded the order transitions to Refunded.
        var response = await Gateway.PostAsync("/api/support/admin/rmas", new { orderId = o.Id, reason = "refunded by admin" }, idempotencyKey: $"refund-{o.Id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
            _status = L["Orders.Status.Refunded"]; // after LoadAsync — it clears _status on refresh
        }
        else
        {
            _error = await response.Content.ReadAsStringAsync();
        }
    }

    private async Task Return(OrderDto o)
    {
        if (_confirm != $"{o.Id}:return") { _confirm = $"{o.Id}:return"; return; }
        _confirm = null;
        // Open a NON-auto-approved RMA: it lands in Requested so the operator walks the full lifecycle
        // (Approve / Approve + physical return → AwaitingReturn → Mark received → refund) in the RMA queue.
        // The order stays Confirmed until the refund is issued, so both actions remain available meanwhile.
        var response = await Gateway.PostAsync("/api/support/admin/rmas", new { orderId = o.Id, reason = "return requested by admin", autoApprove = false }, idempotencyKey: $"return-{o.Id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
            _status = L["Orders.Status.ReturnOpened"]; // after LoadAsync — it clears _status on refresh
        }
        else
        {
            _error = await response.Content.ReadAsStringAsync();
        }
    }

    // The order statuses offered in the status filter (the OrderStatus enum names the endpoint parses).
    private static readonly string[] StatusOptions = ["Pending", "AwaitingPayment", "Confirmed", "Cancelled", "Refunded"];

    // Localized label for the checkout payment option; unknown/legacy values fall back sensibly.
    private string PaymentLabel(string? option) => option switch
    {
        "Stripe" => L["Payment.Method.Stripe"],
        "ApplePay" => L["Payment.Method.ApplePay"],
        "GooglePay" => L["Payment.Method.GooglePay"],
        "PayPal" => L["Payment.Method.PayPal"],
        null or "" or "CreditCard" => L["Payment.Method.CreditCard"],
        _ => option, // future/unknown option — show the raw value rather than hiding it
    };

    public record OrderDto(Guid Id, string Status, long GrossMinor, string Currency, DateTimeOffset CreatedAt, string? PaymentOption = null, Guid? StorefrontId = null, bool PartiallyRefunded = false, bool Disputed = false);
    // Subset of the catalog admin storefront list — for the Storefront column + filter dropdown.
    public record StorefrontDto(Guid Id, string Name, string Currency);
    public record OrderLineDto(Guid ProductId, Guid? VariantId, string? VariantSku, string Title, long UnitPriceMinor, long DiscountMinor, int Quantity, string FulfilmentType, string BillingMode);
    public record ShipAddrDto(string Name, string Line1, string City, string Postcode, string Country);
    public record OrderDetailDto(
        Guid Id, string Status, string Email, long NetMinor, long ShippingMinor, long DiscountMinor, long TaxMinor, long GrossMinor,
        string Currency, DateTimeOffset CreatedAt, List<OrderLineDto> Lines,
        long PublicOrderNumber, string PaymentOption, string? PaymentInstrumentSummary, string PaymentProvider, bool PartiallyRefunded, bool Disputed, ShipAddrDto? ShippingAddress);
}
