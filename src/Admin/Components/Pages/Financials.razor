@page "/financials"
@attribute [Authorize(Roles = "admin")]
@inject GatewayClient Gateway
@rendermode AdminRenderModes.InteractiveServerNoPrerender

<div style="display:flex; align-items:baseline; gap:1rem;">
    <h1 style="margin:0;">@L["Fin.Title"]</h1>
    <span style="color:#6b7280; font-size:.85rem;">@L["Fin.Intro"]</span>
    <span style="flex:1;"></span>
    <button @onclick="LoadAsync" title="@L["Common.Refresh.Tip"]" style="padding:.35rem .8rem;">↻ @L["Common.Refresh"]</button>
</div>

@if (_loading)
{
    <p>@L["Common.Loading"]</p>
}
else if (_balances.Count == 0)
{
    <p style="color:#9ca3af;">@L["Fin.Empty"]</p>
}
else
{
    @* Profit & loss and financial position are computed PER CURRENCY — minor units are not comparable
       across currencies, so each currency is its own report (no FX consolidation without a rate feed). *@
    @foreach (var cur in Currencies)
    {
        <section style="border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.2rem; margin-bottom:1.2rem;">
            <h2 style="margin:0 0 .2rem;">@cur</h2>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.4rem; margin-top:.6rem;">
                <div>
                    <h3 style="margin:.2rem 0 .5rem;">@L["Fin.PnL"]</h3>
                    <table style="border-collapse:collapse; width:100%; font-size:.9rem;">
                        @Line(L["Fin.Revenue"], Revenue(cur), false)
                        @Line(L["Fin.Shipping"], ShippingIncome(cur), false)
                        @Line(L["Fin.Refunds"], -Refunds(cur), false)
                        @Line(L["Fin.Fees"], -Fees(cur), false)
                        @Line(L["Fin.Chargebacks"], -Chargebacks(cur), false)
                        @Line(L["Fin.Cogs"], -Cogs(cur), false)
                        @Line(L["Fin.ShippingCost"], -ShippingCost(cur), false)
                        @Line(L["Fin.Writeoffs"], -Writeoffs(cur), false)
                        @TotalLine(L["Fin.NetResult"], Revenue(cur) + ShippingIncome(cur) - Refunds(cur) - Fees(cur) - Chargebacks(cur) - Cogs(cur) - ShippingCost(cur) - Writeoffs(cur), cur)
                    </table>
                </div>
                <div>
                    <h3 style="margin:.2rem 0 .5rem;">@L["Fin.Position"]</h3>
                    <table style="border-collapse:collapse; width:100%; font-size:.9rem;">
                        <tr><td colspan="2" style="font-weight:600; color:#6b7280; padding-top:.2rem;">@L["Fin.Assets"]</td></tr>
                        @foreach (var (code, amount) in CashByAccount(cur))
                        {
                            @Line(code, amount, true)
                        }
                        @Line(L["Fin.Receivable"], Receivable(cur), true)
                        @TotalLine(L["Fin.TotalAssets"], Cash(cur) + Receivable(cur), cur)
                        <tr><td colspan="2" style="font-weight:600; color:#6b7280; padding-top:.5rem;">@L["Fin.Liabilities"]</td></tr>
                        @Line(L["Fin.TaxCollected"], TaxLiability(cur), true)
                        @Line(L["Fin.CarrierPayable"], CarrierPayable(cur), true)
                        @Line(L["Fin.SupplierPayable"], SupplierPayable(cur), true)
                        @TotalLine(L["Fin.TotalLiabilities"], TaxLiability(cur) + CarrierPayable(cur) + SupplierPayable(cur), cur)
                    </table>
                </div>
            </div>
        </section>
    }

    <section style="border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.2rem; margin-bottom:1.2rem;">
        <h2 style="margin:0 0 .2rem;">@L["Fin.Chart"]</h2>
        <p style="color:#6b7280; font-size:.8rem; margin:0 0 .6rem;">@L["Fin.Chart.Note"]</p>
        <select value="@_chartFor" @onchange="OnChartStoreChanged" style="padding:.35rem .6rem; margin-bottom:.6rem;">
            <option value="">—</option>
            @foreach (var s in _storefronts)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
        @if (_chart.Count > 0)
        {
            <table style="border-collapse:collapse; width:100%; font-size:.9rem;">
                <thead><tr>
                    <th style="text-align:left;">@L["Fin.Col.Account"]</th>
                    <th style="text-align:left;">@L["Ledger.Col.Account"]</th>
                    <th style="text-align:left;">@L["Ledger.Col.Type"]</th>
                    <th style="text-align:right;">@L["Fin.Col.NetRevenue"]</th>
                </tr></thead>
                <tbody>
                @foreach (var a in _chart)
                {
                    <tr style="border-top:1px solid #f3f4f6;">
                        <td>@a.Role</td>
                        <td><code style="font-size:.72rem; color:#6b7280;">@a.Code</code></td>
                        <td>@a.Type</td>
                        <td style="text-align:right; font-variant-numeric:tabular-nums;">@Money(ChartPosted(a))</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>

    <section style="border:1px solid #e5e7eb; border-radius:10px; padding:1rem 1.2rem;">
        <h2 style="margin:0 0 .2rem;">@L["Fin.ByStorefront"]</h2>
        <p style="color:#6b7280; font-size:.8rem; margin:0 0 .6rem;">@L["Fin.ByStorefront.Note"]</p>
        @if (_storefronts.Count == 0)
        {
            <p style="color:#9ca3af;">—</p>
        }
        else
        {
            <table style="border-collapse:collapse; width:100%; font-size:.9rem;">
                <thead><tr>
                    <th style="text-align:left;">@L["Fin.Col.Storefront"]</th>
                    <th>@L["Ledger.Col.Currency"]</th>
                    <th style="text-align:right;">@L["Fin.Col.Gross"]</th>
                    <th style="text-align:right;">@L["Fin.Col.NetRevenue"]</th>
                    <th style="text-align:right;">@L["Fin.Shipping"]</th>
                    <th style="text-align:right;">@L["Fin.Col.Tax"]</th>
                    <th style="text-align:right;">@L["Fin.Cogs"]</th>
                    <th style="text-align:right;">@L["Fin.Col.Margin"]</th>
                    <th style="text-align:right; font-style:italic; color:#b45309;" title="@L["Fin.Estimated.Tip"]">@L["Fin.Col.EstOverheads"]</th>
                    <th style="text-align:right; font-style:italic; color:#b45309;" title="@L["Fin.Estimated.Tip"]">@L["Fin.Col.EstMargin"]</th>
                    <th style="text-align:left;">@L["Fin.Col.Account"]</th>
                </tr></thead>
                <tbody>
                @foreach (var s in _storefronts)
                {
                    <tr style="border-top:1px solid #f3f4f6;">
                        <td>@s.Name</td>
                        <td style="text-align:center;" title="@L["Fin.PostingCurrency.Tip"]">@PostingCurrency(s)</td>
                        <td style="text-align:right;">@Money(StoreGross(s))</td>
                        <td style="text-align:right;">@Money(AccountAmount(s.RevenueAccountCode, creditNormal: true))</td>
                        <td style="text-align:right;">@Money(AccountAmount(s.ShippingAccountCode, creditNormal: true))</td>
                        <td style="text-align:right;">@Money(AccountAmount(s.TaxAccountCode, creditNormal: true))</td>
                        <td style="text-align:right;">@Money(StoreCogs(s))</td>
                        <td style="text-align:right;">@Money(StoreMargin(s))</td>
                        <td style="text-align:right; font-style:italic; color:#b45309;" title="@L["Fin.Estimated.Tip"]">@Money(StoreEstimatedOverheads(s))</td>
                        <td style="text-align:right; font-style:italic; color:#b45309;" title="@L["Fin.Estimated.Tip"]">@Money(StoreEstimatedMargin(s))</td>
                        <td><code style="font-size:.72rem; color:#6b7280;">@s.RevenueAccountCode</code></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private const string Tenant = "00000000-0000-0000-0000-000000000001";
    private bool _loading = true;
    private List<BalanceDto> _balances = [];
    private List<StorefrontDto> _storefronts = [];
    private List<ChartAccountDto> _chart = [];
    private string _chartFor = "";

    protected override Task OnInitializedAsync() => LoadAsync();

    // Load one storefront's full per-storefront chart of accounts (ledger_sf_4) from Payments' authoritative
    // derivation. Balances are overlaid client-side from the balances already loaded (ChartPosted).
    private async Task OnChartStoreChanged(ChangeEventArgs e)
    {
        _chartFor = e.Value?.ToString() ?? "";
        _chart = Guid.TryParse(_chartFor, out var id)
            ? await SafeList<ChartAccountDto>($"/api/payments/admin/ledger/storefronts/{id:D}/chart")
            : [];
    }

    // The account's posted balance in its natural-normal direction, summed across currencies (consistent
    // with the by-storefront table's cross-currency posture — see PostingCurrency). Revenue/Liability are
    // credit-normal; Asset/Expense are debit-normal.
    private long ChartPosted(ChartAccountDto a) =>
        AccountAmount(a.Code, creditNormal: a.Type is "Revenue" or "Liability");

    private async Task LoadAsync()
    {
        _loading = true;
        _balances = await SafeList<BalanceDto>("/api/payments/admin/ledger/balances");
        _storefronts = await SafeList<StorefrontDto>($"/api/catalog/admin/storefronts?tenantId={Tenant}");
        _loading = false;
    }

    private async Task<List<T>> SafeList<T>(string path)
    {
        try { return await Gateway.GetListAsync<T>(path); }
        catch { return []; }
    }

    private IEnumerable<string> Currencies => _balances.Select(b => b.Currency).Distinct().OrderBy(c => c, StringComparer.Ordinal);

    // Credit-normal (revenue/liability): positive = Credit − Debit. Debit-normal (cash/receivable/expense): Debit − Credit.
    private long Sum(string currency, Func<string, bool> match, bool creditNormal) =>
        _balances.Where(b => b.Currency == currency && match(b.AccountCode))
            .Sum(b => creditNormal ? b.CreditMinor - b.DebitMinor : b.DebitMinor - b.CreditMinor);

    // Gross sales revenue = credits to revenue accounts (net of tax — tax posts to tax.*). Refunds =
    // debits to revenue accounts: per-storefront refunds reverse the store's OWN revenue.store (ADR-0040),
    // and legacy/shared refunds hit revenue.refunds — both are debits, so this contra-revenue captures
    // every refund path (was previously only the shared revenue.refunds, so per-store refunds read 0).
    // Net result still = Revenue − Refunds − Fees; the refunded tax reduces the tax-collected liability.
    private long Revenue(string c) => _balances
        .Where(b => b.Currency == c && b.AccountCode.StartsWith("revenue.", StringComparison.Ordinal)).Sum(b => b.CreditMinor);
    private long Refunds(string c) => _balances
        .Where(b => b.Currency == c && b.AccountCode.StartsWith("revenue.", StringComparison.Ordinal)).Sum(b => b.DebitMinor);
    // Shipping charged to shoppers, booked to shipping.* — per-store (shipping.store-…) or the shared
    // shipping.income — its own income line, not revenue.*. Credit-normal, already net of refunds.
    private long ShippingIncome(string c) => Sum(c, a => a.StartsWith("shipping.", StringComparison.Ordinal), creditNormal: true);
    // Processing provider fees ONLY — expense.{provider}_fees (see Accounts.FeesFor), EXCLUDING the
    // chargeback-fee accounts (expense.{provider}_chargeback_fees), which get their own line below so
    // dispute costs are visible separately. Narrower than "all expense.*": COGS, carrier shipping cost,
    // write-offs and chargebacks are each their own P&L line, so a new expense category never silently
    // gets swallowed into "fees".
    private long Fees(string c) => Sum(c, a => a.StartsWith("expense.", StringComparison.Ordinal) && a.EndsWith("_fees", StringComparison.Ordinal) && !a.EndsWith("_chargeback_fees", StringComparison.Ordinal), creditNormal: false);
    // Chargeback (dispute) fees only — expense.{provider}_chargeback_fees (see Accounts.ChargebackFeesFor).
    // The disputed sale's revenue/tax reversal is contra-revenue (lands in Refunds, like a refund); this
    // line surfaces the dispute FEE on its own. Debit-normal.
    private long Chargebacks(string c) => Sum(c, a => a.StartsWith("expense.", StringComparison.Ordinal) && a.EndsWith("_chargeback_fees", StringComparison.Ordinal), creditNormal: false);
    // Cost of goods sold: the shared expense.cogs plus every per-store expense.cogs.store-{id} (see
    // Accounts.CogsStoreFor). Debit-normal like every expense account.
    private long Cogs(string c) => Sum(c, a => a.StartsWith("expense.cogs", StringComparison.Ordinal), creditNormal: false);
    // Carrier label cost: the shared expense.shipping_carrier fallback plus every per-store
    // expense.shipping.store-{id} (see Accounts.ShippingCostStoreFor). Distinct from shipping.* which is
    // the INCOME shoppers pay for shipping — this is what the platform pays the carrier.
    private long ShippingCost(string c) => Sum(c, a => a == "expense.shipping_carrier" || a.StartsWith("expense.shipping.store-", StringComparison.Ordinal), creditNormal: false);
    // Inventory write-offs from RMA Storage dispositions: the shared expense.writeoffs plus every
    // per-store expense.writeoffs.store-{id} (see Accounts.WriteoffsStoreFor).
    private long Writeoffs(string c) => Sum(c, a => a.StartsWith("expense.writeoffs", StringComparison.Ordinal), creditNormal: false);
    private long Cash(string c) => Sum(c, a => a.StartsWith("cash.", StringComparison.Ordinal), creditNormal: false);
    private long Receivable(string c) => Sum(c, a => a.StartsWith("receivable.", StringComparison.Ordinal), creditNormal: false);
    private long TaxLiability(string c) => Sum(c, a => a.StartsWith("tax.", StringComparison.Ordinal) || a == "liability.tax_collected", creditNormal: true);
    // Carrier label cost owed but not yet paid (accrual, mirrors liability.supplier_payable) — credit-normal.
    // The shared liability.carrier_payable fallback PLUS every per-store liability.carrier_payable.store-{id}
    // (ledger_sf_3, Accounts.CarrierPayableStoreFor) — a StartsWith so per-store accruals aren't undercounted.
    private long CarrierPayable(string c) => Sum(c, a => a.StartsWith("liability.carrier_payable", StringComparison.Ordinal), creditNormal: true);
    // COGS accrued to suppliers via SupplierPayable.ToAccrualEntry — credit-normal. Shared
    // liability.supplier_payable plus every per-store liability.supplier_payable.store-{id} (ledger_sf_3).
    private long SupplierPayable(string c) => Sum(c, a => a.StartsWith("liability.supplier_payable", StringComparison.Ordinal), creditNormal: true);

    private IEnumerable<(string Code, long Amount)> CashByAccount(string currency) => _balances
        .Where(b => b.Currency == currency && b.AccountCode.StartsWith("cash.", StringComparison.Ordinal))
        .OrderBy(b => b.AccountCode, StringComparer.Ordinal)
        .Select(b => (b.AccountCode, b.DebitMinor - b.CreditMinor));

    // Match a storefront account by code across ALL currencies it posted in — a store's revenue lands in
    // the checkout (posting) currency, which may differ from its configured currency until per-store
    // checkout currency ships. Amounts are shown in the posting currency (see PostingCurrency).
    private long AccountAmount(string code, bool creditNormal) =>
        _balances.Where(b => b.AccountCode == code)
            .Sum(b => creditNormal ? b.CreditMinor - b.DebitMinor : b.DebitMinor - b.CreditMinor);

    // Total sales the storefront brought in = net revenue + tax collected (both credit-normal). Ties the
    // row together: Gross = Net revenue + Tax, and per currency these sum to the P&L revenue + tax above.
    private long StoreGross(StorefrontDto s) =>
        AccountAmount(s.RevenueAccountCode, creditNormal: true)
        + AccountAmount(s.ShippingAccountCode, creditNormal: true)
        + AccountAmount(s.TaxAccountCode, creditNormal: true);

    // Per-store expense codes are derived here in Payments-adjacent Admin the same way Payments derives
    // them (Accounts.CogsStoreFor/ShippingCostStoreFor/WriteoffsStoreFor) — operators never override
    // these, so there is no Catalog-configured column to read them from (unlike RevenueAccountCode etc).
    private long StoreCogs(StorefrontDto s) => AccountAmount($"expense.cogs.store-{s.Id:N}", creditNormal: false);
    private long StoreShippingCost(StorefrontDto s) => AccountAmount($"expense.shipping.store-{s.Id:N}", creditNormal: false);
    private long StoreWriteoffs(StorefrontDto s) => AccountAmount($"expense.writeoffs.store-{s.Id:N}", creditNormal: false);

    // Contribution margin for the store: net revenue + shipping income, less its own COGS, carrier
    // shipping cost and write-offs (all debit-normal expenses). Excludes processing fees (provider-level,
    // not per-store) and tax (a pass-through liability, not P&L).
    private long StoreMargin(StorefrontDto s) =>
        AccountAmount(s.RevenueAccountCode, creditNormal: true)
        + AccountAmount(s.ShippingAccountCode, creditNormal: true)
        - StoreCogs(s) - StoreShippingCost(s) - StoreWriteoffs(s);

    // ESTIMATED overheads (phase 4): the store's cost-assumption bps (packaging + labour + marketing +
    // insurance + buffer) applied to its gross. These are operator ASSUMPTIONS — no ledger posting backs
    // them — so the columns render visually distinct (italic/amber) from the posted figures above.
    private long StoreEstimatedOverheads(StorefrontDto s)
    {
        var totalBps = s.CostAssumptions?.Values.Sum() ?? 0;
        return totalBps <= 0 ? 0 : StoreGross(s) * totalBps / 10000;
    }

    // Estimated net margin = the real (posted) contribution margin, less the estimated overheads.
    private long StoreEstimatedMargin(StorefrontDto s) => StoreMargin(s) - StoreEstimatedOverheads(s);

    // The currency the store's revenue actually posted in (distinct), else its configured currency.
    private string PostingCurrency(StorefrontDto s)
    {
        var posted = _balances
            .Where(b => b.AccountCode == s.RevenueAccountCode || b.AccountCode == s.TaxAccountCode || b.AccountCode == s.ReceivableAccountCode)
            .Select(b => b.Currency).Distinct().ToList();
        return posted.Count > 0 ? string.Join("/", posted.OrderBy(c => c, StringComparer.Ordinal)) : s.Currency;
    }

    private static string Money(long minor) => $"{minor / 100m:N2}";

    private RenderFragment Line(string label, long minor, bool asset) => builder =>
    {
        builder.AddMarkupContent(0,
            $"<tr><td style=\"padding:.15rem 0; color:#374151;\">{label}</td>" +
            $"<td style=\"text-align:right; font-variant-numeric:tabular-nums;\">{Money(minor)}</td></tr>");
    };

    private RenderFragment TotalLine(string label, long minor, string currency) => builder =>
    {
        var color = minor >= 0 ? "#047857" : "#b91c1c";
        builder.AddMarkupContent(0,
            $"<tr style=\"border-top:1px solid #e5e7eb;\"><td style=\"padding:.3rem 0; font-weight:700;\">{label}</td>" +
            $"<td style=\"text-align:right; font-weight:700; color:{color};\">{Money(minor)} {currency}</td></tr>");
    };

    public record BalanceDto(string AccountCode, string Currency, long DebitMinor, long CreditMinor, long NetMinor);
    public record ChartAccountDto(string Role, string Code, string Name, string Type);
    public record StorefrontDto(Guid Id, string Name, string Currency, string ReceivableAccountCode, string RevenueAccountCode, string TaxAccountCode, string ShippingAccountCode = "", Dictionary<string, int>? CostAssumptions = null);
}
