@page "/suppliers"
@attribute [Authorize(Roles = "admin")]
@using System.Text.Json
@using System.Net.Http.Json
@inject GatewayClient Gateway
@rendermode AdminRenderModes.InteractiveServerNoPrerender

<h1>@L["Suppliers.Title"]</h1>
<p style="color:#6b7280;">@L["Suppliers.Intro"]</p>

<div style="display:flex; gap:.5rem; align-items:center; margin-bottom:1rem;">
    <label style="font-size:.85rem;">@L["Suppliers.Tenant"] <input @bind="_tenantId" style="width:24rem; padding:.3rem; margin-left:.3rem;" title="@L["Suppliers.Tenant.Tip"]" /></label>
    <button @onclick="LoadAsync" title="@L["Common.Load.Tip"]" style="padding:.35rem .8rem;">@L["Common.Load"]</button>
</div>

@if (_error is not null) { <p style="color:#b91c1c;">@_error</p> }
@if (_info is not null) { <p style="color:#15803d;">@_info</p> }

@if (_selected is not null)
{
    <div style="display:flex; align-items:baseline; gap:1rem;">
        <h2 style="margin:0;">@_selected.DisplayName</h2>
        <button @onclick="CloseDetail" title="@L["Common.Back.Tip"]">@L["Common.Back"]</button>
    </div>

    @* Onboarding lifecycle: the full set of transitions for this supplier, in one place — the admin no
       longer needs to bounce to the generic Entities console to move a supplier through onboarding. *@
    <section style="border:1px solid #e5e7eb; border-radius:8px; padding:1rem; margin:.8rem 0; max-width:60rem;">
        <div style="display:flex; align-items:center; gap:1rem; flex-wrap:wrap;">
            <span style="font-size:.9rem;">@L["Suppliers.Status"]:
                <strong style="color:@(IsActive(_selected) ? "#047857" : "#b45309");">@StateName(_selected.OnboardingState)</strong>
            </span>
            <button @onclick="Approve" disabled="@(IsActive(_selected) || _saving)" title="@L["Suppliers.Approve.Tip"]"
                    style="padding:.35rem .9rem; background:@(IsActive(_selected) ? "#9ca3af" : "#047857"); color:#fff; border:0; border-radius:5px;">
                @L["Suppliers.Approve"]
            </button>
        </div>
        <h3 style="margin:.8rem 0 .3rem;">@L["Suppliers.Lifecycle.Heading"]</h3>
        <label style="font-size:.8rem; display:block; margin-bottom:.4rem;">@L["Entities.SuspendReason"] <input @bind="_suspendReason" style="width:100%; max-width:30rem; padding:.3rem;" title="@L["Entities.SuspendReason.Tip"]" /></label>
        <div style="display:flex; gap:.4rem; flex-wrap:wrap;">
            <button @onclick='() => Lifecycle("suppliers/submit-verification")' disabled="@_saving" style="font-size:.8rem;" title="@L["Entities.Action.Verify.Tip"]">@L["Entities.Action.Verify"]</button>
            <button @onclick='() => Lifecycle("suppliers/verification-complete")' disabled="@_saving" style="font-size:.8rem;" title="@L["Entities.Action.Verified.Tip"]">@L["Entities.Action.Verified"]</button>
            <button @onclick='() => Lifecycle("suppliers/activate")' disabled="@_saving" style="font-size:.8rem;" title="@L["Entities.Action.Activate.Tip"]">@L["Entities.Action.Activate"]</button>
            <button @onclick='() => Lifecycle("suppliers/suspend")' disabled="@_saving" style="font-size:.8rem;" title="@L["Entities.Action.Suspend.Tip"]">@L["Entities.Action.Suspend"]</button>
            <button @onclick='() => Lifecycle("suppliers/archive")' disabled="@_saving" style="font-size:.8rem; color:#b91c1c;" title="@L["Entities.Action.Archive.Tip"]">@L["Entities.Action.Archive"]</button>
        </div>
    </section>

    @* Onboarding readiness — the required fields still missing for this supplier (verified ABN/ACN, a
       primary contact, a registered-office/warehouse address). Fill them in the sections below. *@
    <div style="border:1px solid #e5e7eb; border-radius:8px; padding:.8rem; margin:.6rem 0; max-width:60rem; background:@(_detailMissing.Count == 0 ? "#f0fdf4" : "#fffbeb");">
        @if (_details is null) { <span style="color:#9ca3af;">@L["Common.Loading"]</span> }
        else if (_detailMissing.Count == 0) { <strong style="color:#047857;">@L["Entities.Details.Ready"]</strong> }
        else
        {
            <strong style="color:#b45309;">@L["Entities.Details.Missing"]</strong>
            <ul style="margin:.3rem 0 0;">
                @foreach (var m in _detailMissing) { <li style="font-size:.85rem;">@m</li> }
            </ul>
        }
    </div>

    <section style="border:1px solid #e5e7eb; border-radius:8px; padding:1rem; max-width:60rem;">
        <h3 style="margin-top:0;">@L["Suppliers.Details.Heading"]</h3>
        <div style="display:flex; flex-direction:column; gap:.5rem; max-width:34rem;">
            <label>@L["Suppliers.Field.LegalName"] <input @bind="_editLegalName" style="width:100%; padding:.4rem;" title="@L["Suppliers.Field.LegalName.Tip"]" /></label>
            <label>@L["Suppliers.Field.TradingName"] <input @bind="_editTradingName" style="width:100%; padding:.4rem;" title="@L["Suppliers.Field.TradingName.Tip"]" /></label>
            <label>@L["Common.Type"] <input value="@TypeName(_selected.Type)" disabled style="width:100%; padding:.4rem; background:#f9fafb;" /></label>
            <div>
                <button @onclick="SaveDetails" disabled="@_saving" title="@L["Common.Save.Tip"]" style="padding:.4rem 1rem; background:#111827; color:#fff; border:0; border-radius:5px;">@(_saving ? L["Common.Saving"] : L["Common.Save"])</button>
            </div>
        </div>
    </section>

    @if (_details is not null)
    {
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; max-width:60rem; margin-top:1.2rem;">
            <section style="border:1px solid #e5e7eb; border-radius:8px; padding:1rem;">
                <h3 style="margin-top:0;">@L["Entities.Ident.Heading"]</h3>
                @if (_details.Identifiers.Count == 0) { <p style="color:#9ca3af; font-size:.85rem;">@L["Entities.Ident.None"]</p> }
                else
                {
                    <ul style="padding-left:1rem;">
                        @foreach (var i in _details.Identifiers)
                        {
                            <li style="margin:.3rem 0; font-size:.88rem;">
                                <strong>@IdTypeName(i.Type)</strong> <code>@i.Value</code>
                                @if (i.VerificationStatus == VerifiedStatus) { <span style="color:#047857;">✓ @VStatusName(i.VerificationStatus)</span> }
                                else
                                {
                                    <span style="color:#b45309;">@VStatusName(i.VerificationStatus)</span>
                                    <button @onclick="() => VerifyIdentifier(i.Id)" title="@L["Entities.Ident.Verify.Tip"]" style="font-size:.72rem; margin-left:.3rem;">@L["Entities.Ident.Verify"]</button>
                                }
                            </li>
                        }
                    </ul>
                }
                <div style="display:flex; gap:.4rem; margin-top:.5rem;">
                    <select @bind="_newIdentType" title="@L["Entities.Ident.Type.Tip"]">
                        <option value="1">@L["Entities.IdType.Abn"]</option>
                        <option value="2">@L["Entities.IdType.Acn"]</option>
                        <option value="3">@L["Entities.IdType.Gst"]</option>
                        <option value="4">@L["Entities.IdType.Other"]</option>
                    </select>
                    <input @bind="_newIdentValue" placeholder="@L["Entities.Ident.Value"]" title="@L["Entities.Ident.Value.Tip"]" style="flex:1;" />
                    <button @onclick="AddIdentifier" title="@L["Entities.Ident.Add.Tip"]">@L["Common.Add"]</button>
                </div>
            </section>

            <section style="border:1px solid #e5e7eb; border-radius:8px; padding:1rem;">
                <h3 style="margin-top:0;">@L["Entities.Contact.Heading"]</h3>
                @if (_details.Contacts.Count == 0) { <p style="color:#9ca3af; font-size:.85rem;">@L["Entities.Contact.None"]</p> }
                else
                {
                    <ul style="padding-left:1rem;">
                        @foreach (var c in _details.Contacts)
                        {
                            <li style="margin:.3rem 0; font-size:.88rem;"><strong>@CPurposeName(c.Purpose)</strong> · @CKindName(c.Kind) · @c.Value</li>
                        }
                    </ul>
                }
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:.4rem; margin-top:.5rem;">
                    <select @bind="_newContactPurpose" title="@L["Entities.Contact.Purpose.Tip"]">
                        <option value="1">@L["Entities.CPurpose.Primary"]</option>
                        <option value="2">@L["Entities.CPurpose.Accounts"]</option>
                        <option value="3">@L["Entities.CPurpose.Operations"]</option>
                        <option value="4">@L["Entities.CPurpose.Support"]</option>
                        <option value="5">@L["Entities.CPurpose.Legal"]</option>
                    </select>
                    <select @bind="_newContactKind" title="@L["Entities.Contact.Kind.Tip"]">
                        <option value="1">@L["Entities.CKind.Email"]</option>
                        <option value="2">@L["Entities.CKind.Phone"]</option>
                        <option value="3">@L["Entities.CKind.Website"]</option>
                    </select>
                </div>
                <div style="display:flex; gap:.4rem; margin-top:.4rem;">
                    <input @bind="_newContactValue" placeholder="@L["Entities.Contact.Value"]" title="@L["Entities.Contact.Value.Tip"]" style="flex:1;" />
                    <button @onclick="AddContact" title="@L["Entities.Contact.Add.Tip"]">@L["Common.Add"]</button>
                </div>
            </section>
        </div>

        <section style="border:1px solid #e5e7eb; border-radius:8px; padding:1rem; margin-top:1.2rem; max-width:60rem;">
            <h3 style="margin-top:0;">@L["Entities.Addr.Heading"]</h3>
            <p style="color:#6b7280; font-size:.82rem; margin-top:0;">@L["Suppliers.Addr.WarehouseHint"]</p>
            @if (_details.Addresses.Count == 0) { <p style="color:#9ca3af; font-size:.85rem;">@L["Entities.Addr.None"]</p> }
            else
            {
                <ul style="padding-left:1rem;">
                    @foreach (var a in _details.Addresses)
                    {
                        <li style="margin:.3rem 0; font-size:.88rem;"><strong>@AddrPurposeName(a.Purpose)</strong> · @a.Line1@(string.IsNullOrEmpty(a.Line2) ? "" : $", {a.Line2}"), @a.City @a.Region @a.Postcode @a.CountryCode</li>
                    }
                </ul>
            }
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr)); gap:.4rem; margin-top:.5rem;">
                <select @bind="_newAddrPurpose" title="@L["Entities.Addr.Purpose.Tip"]">
                    <option value="4">@L["Entities.AddrPurpose.Warehouse"]</option>
                    <option value="1">@L["Entities.AddrPurpose.RegisteredOffice"]</option>
                    <option value="2">@L["Entities.AddrPurpose.Billing"]</option>
                    <option value="3">@L["Entities.AddrPurpose.Shipping"]</option>
                    <option value="5">@L["Entities.AddrPurpose.Returns"]</option>
                    <option value="6">@L["Entities.AddrPurpose.Mailing"]</option>
                </select>
                <input @bind="_newAddr.Line1" placeholder="@L["Entities.Addr.Line1"]" title="@L["Entities.Addr.Line1.Tip"]" />
                <input @bind="_newAddr.Line2" placeholder="@L["Entities.Addr.Line2"]" title="@L["Entities.Addr.Line2.Tip"]" />
                <input @bind="_newAddr.City" placeholder="@L["Entities.Addr.City"]" title="@L["Entities.Addr.City.Tip"]" />
                <input @bind="_newAddr.Region" placeholder="@L["Entities.Addr.Region"]" title="@L["Entities.Addr.Region.Tip"]" />
                <input @bind="_newAddr.Postcode" placeholder="@L["Entities.Addr.Postcode"]" title="@L["Entities.Addr.Postcode.Tip"]" />
                <select @bind="_newAddr.CountryCode" title="@L["Entities.Addr.Country.Tip"]">
                    <option value="">@L["Entities.Addr.Country"]</option>
                    @foreach (var c in CountryList.All) { <option value="@c.Code">@c.Name</option> }
                </select>
                <button @onclick="AddAddress" title="@L["Entities.Addr.Add.Tip"]">@L["Common.Add"]</button>
            </div>
        </section>

        <section style="border:1px solid #e5e7eb; border-radius:8px; padding:1rem; margin-top:1.2rem; max-width:60rem;">
            <h3 style="margin-top:0;">@L["Suppliers.Requests.Heading"]</h3>
            <label style="font-size:.85rem; display:block;">@L["Entities.DecisionReason"] <input @bind="_decisionReason" style="width:100%; max-width:30rem; padding:.3rem;" placeholder="@L["Entities.DecisionReason.Placeholder"]" title="@L["Entities.DecisionReason.Tip"]" /></label>
            @if (_requests.Count == 0) { <p style="color:#9ca3af; margin-top:.5rem;">@L["Suppliers.Requests.Empty"]</p> }
            else
            {
                @foreach (var r in _requests)
                {
                    <div style="border:1px solid #e5e7eb; border-radius:8px; padding:.7rem; margin-top:.6rem;">
                        <div style="display:flex; justify-content:space-between;">
                            <strong>@ChangeTypeName(r.Type)</strong>
                            <span style="font-size:.75rem; color:#6b7280;">@r.CreatedAt.LocalDateTime.ToString("dd MMM HH:mm")</span>
                        </div>
                        <div style="font-size:.9rem; margin:.2rem 0;">@r.Summary</div>
                        @if (!string.IsNullOrWhiteSpace(r.Detail)) { <div style="font-size:.82rem; color:#4b5563;">@r.Detail</div> }
                        <div style="font-size:.75rem; color:#9ca3af;">@L["Entities.RequestedBy", r.RequestedByPrincipalId.ToString()[..8]]</div>
                        @{ var mine = _myPrincipalId is not null && r.RequestedByPrincipalId == _myPrincipalId; }
                        @if (mine)
                        {
                            <div style="font-size:.78rem; color:#92400e; margin-top:.3rem;">@L["Entities.MakerChecker"]</div>
                        }
                        <div style="margin-top:.4rem; display:flex; gap:.4rem;">
                            <button @onclick='() => DecideAsync(r.Id, "approve")' disabled="@(mine || _saving)" title="@(mine ? L["Entities.Approve.OwnTip"] : L["Entities.Approve.Tip"])" style="padding:.25rem .7rem; background:@(mine ? "#9ca3af" : "#047857"); color:#fff; border:0; border-radius:4px;">@L["Entities.Approve"]</button>
                            <button @onclick='() => DecideAsync(r.Id, "reject")' disabled="@(mine || _saving)" title="@(mine ? L["Entities.Reject.OwnTip"] : L["Entities.Reject.Tip"])" style="padding:.25rem .7rem; background:@(mine ? "#9ca3af" : "#b91c1c"); color:#fff; border:0; border-radius:4px;">@L["Entities.Reject"]</button>
                        </div>
                    </div>
                }
            }
        </section>
    }

    @* Product cost — the primary reason to open a supplier. Prominent by design (ADR-0047): the ONLY
       place a supplier's per-product / per-variant cost is set. Product-level offers have a null variant,
       so the product title (never a blank cell) identifies the row. *@
    <section style="border:2px solid #111827; border-radius:8px; padding:1rem; margin-top:1.4rem; max-width:64rem; background:#fbfbfe;">
        <h3 style="margin-top:0; display:flex; align-items:center; gap:.6rem;">
            @L["Suppliers.Offers.Heading"]
            @if (_offers is not null) { <span style="font-size:.8rem; font-weight:600; color:#fff; background:#111827; border-radius:999px; padding:.1rem .6rem;">@L["Suppliers.Offers.Count", _offers.Count]</span> }
        </h3>
        <p style="color:#6b7280; font-size:.85rem;">@L["Suppliers.Offers.Intro"]</p>
        @if (_offers is null) { <p style="color:#9ca3af;">@L["Common.Loading"]</p> }
        else if (_offers.Count == 0) { <p style="color:#9ca3af;">@L["Suppliers.Offers.Empty"]</p> }
        else
        {
            <table data-testid="supplier-offer-cost-table" style="border-collapse:collapse; width:100%; font-size:.9rem;">
                <thead><tr style="text-align:left; border-bottom:2px solid #e5e7eb;">
                    <th style="padding:.4rem;">@L["Suppliers.Offers.Col.Product"]</th>
                    <th>@L["Suppliers.Offers.Col.Sku"]</th>
                    <th>@L["Suppliers.Offers.Col.Currency"]</th>
                    <th>@L["Suppliers.Offers.Col.Cost"]</th>
                    <th>@L["Common.Actions"]</th>
                </tr></thead>
                <tbody>
                @foreach (var row in _offers)
                {
                    <tr data-offer-row="@(string.IsNullOrWhiteSpace(row.ProductTitle) ? Short(row.ProductId) : row.ProductTitle)|@(string.IsNullOrWhiteSpace(row.VariantSku) ? "—" : row.VariantSku)" style="border-bottom:1px solid #f3f4f6;">
                        <td style="padding:.4rem;">@(string.IsNullOrWhiteSpace(row.ProductTitle) ? Short(row.ProductId) : row.ProductTitle)</td>
                        <td><code>@(string.IsNullOrWhiteSpace(row.VariantSku) ? "—" : row.VariantSku)</code></td>
                        <td>@row.Currency</td>
                        <td><input type="number" @bind="row.SupplierCostMinor" title="@L["Suppliers.Offers.Col.Cost.Tip"]" style="width:9rem; padding:.25rem;" /></td>
                        <td><button @onclick="() => SaveCost(row)" disabled="@_saving" title="@L["Suppliers.Offers.Save.Tip"]" style="padding:.25rem .7rem;">@L["Common.Save"]</button></td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}
else
{
    <h2>@L["Suppliers.List"]</h2>
    @if (_suppliers.Count == 0) { <p style="color:#9ca3af;">@L["Suppliers.Empty"]</p> }
    else
    {
        <table style="border-collapse:collapse; width:100%; font-size:.9rem; max-width:50rem;">
            <thead><tr style="text-align:left; border-bottom:2px solid #e5e7eb;">
                <th style="padding:.4rem;">@L["Common.Name"]</th>
                <th>@L["Common.Type"]</th>
                <th>@L["Suppliers.Status"]</th>
                <th>@L["Common.Actions"]</th>
            </tr></thead>
            <tbody>
            @foreach (var s in _suppliers)
            {
                <tr style="border-bottom:1px solid #f3f4f6;">
                    <td style="padding:.4rem;">@s.DisplayName</td>
                    <td>@TypeName(s.Type)</td>
                    <td><strong style="color:@(IsActive(s) ? "#047857" : "#b45309");">@StateName(s.OnboardingState)</strong></td>
                    <td><button @onclick="() => OpenDetail(s)" title="@L["Suppliers.Manage.Tip"]" style="padding:.25rem .7rem;">@L["Suppliers.Manage"]</button></td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@code {
    private const int ActiveState = 4; // SupplierOnboardingState.Active
    private const int VerifiedStatus = 3; // EntityVerificationStatus.Verified
    private string _tenantId = "00000000-0000-0000-0000-000000000001";
    private string? _error;
    private string? _info;
    private bool _saving;
    private List<SupplierSummary> _suppliers = [];
    private SupplierSummary? _selected;
    private string _editLegalName = string.Empty;
    private string _editTradingName = string.Empty;
    private List<OfferRow>? _offers;
    private Guid? _myPrincipalId;

    // Supplier detail (identifiers/contacts/addresses), readiness, and this supplier's change requests.
    private EntityDetail? _details;
    private List<string> _detailMissing = [];
    private List<ChangeRequest> _requests = [];
    private int _newIdentType = 1;
    private string _newIdentValue = string.Empty;
    private int _newContactPurpose = 1;
    private int _newContactKind = 1;
    private string _newContactValue = string.Empty;
    private int _newAddrPurpose = 4; // Warehouse (the address suppliers most often set here)
    private readonly AddressForm _newAddr = new();
    private string _suspendReason = "Suspended by operator via admin.";
    private string _decisionReason = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Who am I? Needed for maker-checker: the requester of a change request cannot also decide it.
        var me = await Gateway.GetAsync<MeResponse>("/api/identity/me");
        _myPrincipalId = me?.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = _info = null;
        if (!Guid.TryParse(_tenantId, out _))
        {
            _error = L["Suppliers.Error.TenantGuid"];
            return;
        }

        // A supplier is an entity that has started onboarding (OnboardingState is non-null); other
        // entities in the tenant are hidden from this page.
        var entities = await Gateway.GetListAsync<SupplierSummary>($"/api/entity/entities?tenantId={_tenantId}");
        _suppliers = entities.Where(e => e.OnboardingState is not null).ToList();
        _selected = null;
        _offers = null;
        _details = null;
        _detailMissing = [];
        _requests = [];
    }

    private async Task OpenDetail(SupplierSummary supplier)
    {
        _error = _info = null;
        _selected = supplier;
        _editLegalName = supplier.LegalName;
        _editTradingName = supplier.TradingName ?? string.Empty;
        await LoadDetailAsync();
    }

    private void CloseDetail()
    {
        _selected = null;
        _offers = null;
        _details = null;
        _detailMissing = [];
        _requests = [];
    }

    // Load everything the detail view shows for the selected supplier: entity details, readiness,
    // this supplier's pending change requests, and its supplied offers.
    private async Task LoadDetailAsync()
    {
        if (_selected is null) { return; }
        var id = _selected.Id;
        _details = await Gateway.GetAsync<EntityDetail>($"/api/entity/entities/{id}");
        var readiness = await Gateway.GetAsync<ReadinessDto>($"/api/entity/entities/{id}/suppliers/readiness");
        _detailMissing = readiness?.MissingRequirements ?? [];
        var requests = await Gateway.GetListAsync<ChangeRequest>($"/api/entity/entities/suppliers/change-requests?tenantId={_tenantId}&status=Pending");
        _requests = requests.Where(r => r.EntityId == id).ToList();
        await LoadOffersAsync();
    }

    private async Task LoadOffersAsync()
    {
        if (_selected is null) { return; }
        _offers = await Gateway.GetListAsync<OfferRow>($"/api/catalog/admin/offers?tenantId={_tenantId}&supplierId={_selected.Id}");
    }

    private async Task SaveDetails()
    {
        if (_selected is null) { return; }
        _error = _info = null;
        _saving = true;
        try
        {
            var response = await Gateway.PutAsync($"/api/entity/entities/{_selected.Id}",
                new { legalName = _editLegalName, tradingName = string.IsNullOrWhiteSpace(_editTradingName) ? null : _editTradingName });
            if (response.IsSuccessStatusCode)
            {
                _info = L["Suppliers.Info.Updated"];
                await ReloadKeepingSelection();
            }
            else
            {
                _error = L["Suppliers.Error.UpdateFailed", await GatewayError.ReadAsync(response)];
            }
        }
        finally
        {
            _saving = false;
        }
    }

    // The "Approve" shortcut = activate. Kept as a first-class button because approving (activating) a
    // pending supplier is the most common single action; the lifecycle row offers the rest.
    private async Task Approve()
    {
        if (_selected is null) { return; }
        _error = _info = null;
        _saving = true;
        try
        {
            var response = await Gateway.PostAsync($"/api/entity/entities/{_selected.Id}/suppliers/activate");
            if (response.IsSuccessStatusCode)
            {
                _info = L["Suppliers.Info.Approved"];
                await ReloadKeepingSelection();
            }
            else
            {
                _error = L["Suppliers.Error.ApproveFailed", await ReadFailureAsync(response)];
            }
        }
        finally
        {
            _saving = false;
        }
    }

    // Onboarding lifecycle transitions (submit-verification / verification-complete / activate / suspend
    // / archive). Suspend requires an 8–500 char reason body; the others take none (an empty body 500s).
    private async Task Lifecycle(string action)
    {
        if (_selected is null) { return; }
        _error = _info = null;
        object? body = null;
        if (action.EndsWith("suspend", StringComparison.Ordinal))
        {
            var reason = string.IsNullOrWhiteSpace(_suspendReason) ? "Suspended by operator via admin." : _suspendReason.Trim();
            if (reason.Length < 8)
            {
                _error = L["Entities.Error.SuspendReason"];
                return;
            }

            body = new { reason };
        }

        _saving = true;
        try
        {
            var response = await Gateway.PostAsync($"/api/entity/entities/{_selected.Id}/{action}", body);
            if (response.IsSuccessStatusCode) { _info = L["Entities.Info.SupplierOk", action.Split('/').Last()]; await ReloadKeepingSelection(); }
            else { _error = L["Entities.Error.ActionFailed", await ReadFailureAsync(response)]; }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveCost(OfferRow row)
    {
        _error = _info = null;
        _saving = true;
        try
        {
            var response = await Gateway.PutAsync($"/api/catalog/admin/offers/{row.Id}", new { supplierCostMinor = row.SupplierCostMinor });
            if (response.IsSuccessStatusCode)
            {
                _info = L["Suppliers.Info.CostSaved", string.IsNullOrWhiteSpace(row.ProductTitle) ? Short(row.ProductId) : row.ProductTitle];
                await LoadOffersAsync();
            }
            else
            {
                _error = L["Suppliers.Error.CostFailed", await GatewayError.ReadAsync(response)];
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AddIdentifier()
    {
        if (_details is null || string.IsNullOrWhiteSpace(_newIdentValue)) { return; }
        await PostDetail($"/api/entity/entities/{_details.Id}/identifiers", new { type = _newIdentType, value = _newIdentValue.Trim() }, "Entities.Info.IdentifierAdded");
        _newIdentValue = string.Empty;
    }

    private Task VerifyIdentifier(Guid identifierId) =>
        _details is null ? Task.CompletedTask
            : PostDetail($"/api/entity/entities/{_details.Id}/identifiers/{identifierId}/verify", new { }, "Entities.Info.IdentifierVerified");

    private async Task AddContact()
    {
        if (_details is null || string.IsNullOrWhiteSpace(_newContactValue)) { return; }
        await PostDetail($"/api/entity/entities/{_details.Id}/contacts", new { purpose = _newContactPurpose, kind = _newContactKind, value = _newContactValue.Trim() }, "Entities.Info.ContactAdded");
        _newContactValue = string.Empty;
    }

    private async Task AddAddress()
    {
        if (_details is null) { return; }
        var body = new
        {
            purpose = _newAddrPurpose,
            line1 = _newAddr.Line1.Trim(),
            line2 = string.IsNullOrWhiteSpace(_newAddr.Line2) ? null : _newAddr.Line2.Trim(),
            city = _newAddr.City.Trim(),
            region = string.IsNullOrWhiteSpace(_newAddr.Region) ? null : _newAddr.Region.Trim(),
            postcode = _newAddr.Postcode.Trim(),
            countryCode = _newAddr.CountryCode.Trim(),
        };
        await PostDetail($"/api/entity/entities/{_details.Id}/addresses", body, "Entities.Info.AddressAdded");
        _newAddr.Reset();
    }

    private async Task PostDetail(string path, object body, string okKey)
    {
        _error = _info = null;
        _saving = true;
        try
        {
            var response = await Gateway.PostAsync(path, body);
            if (response.IsSuccessStatusCode) { _info = L[okKey]; await LoadDetailAsync(); }
            else { _error = L["Entities.Error.ActionFailed", await ReadFailureAsync(response)]; }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DecideAsync(Guid requestId, string decision)
    {
        _error = _info = null;
        var reason = string.IsNullOrWhiteSpace(_decisionReason) ? null : _decisionReason.Trim();

        // Reject requires an 8–500 char reason; approve's reason is optional. Validate up-front.
        if (decision == "reject" && (reason is null || reason.Length < 8))
        {
            _error = L["Entities.Error.RejectReason"];
            return;
        }

        if (reason is { Length: > 500 })
        {
            _error = L["Entities.Error.ReasonTooLong"];
            return;
        }

        _saving = true;
        try
        {
            var response = await Gateway.PostAsync($"/api/entity/entities/suppliers/change-requests/{requestId}/{decision}?tenantId={_tenantId}",
                new { reason });
            if (response.IsSuccessStatusCode)
            {
                _info = decision == "approve" ? L["Suppliers.Info.Approved.Request"] : L["Entities.Info.Rejected"];
                _decisionReason = string.Empty;
                await LoadDetailAsync();
            }
            else
            {
                _error = L["Entities.Error.ActionFailed", await ReadFailureAsync(response)];
            }
        }
        finally
        {
            _saving = false;
        }
    }

    // Refresh the supplier list (to pick up a changed name/status) and keep the same supplier open.
    private async Task ReloadKeepingSelection()
    {
        var id = _selected!.Id;
        var entities = await Gateway.GetListAsync<SupplierSummary>($"/api/entity/entities?tenantId={_tenantId}");
        _suppliers = entities.Where(e => e.OnboardingState is not null).ToList();
        _selected = _suppliers.FirstOrDefault(s => s.Id == id);
        if (_selected is not null)
        {
            _editLegalName = _selected.LegalName;
            _editTradingName = _selected.TradingName ?? string.Empty;
            await LoadDetailAsync();
        }
        else
        {
            _offers = null;
            _details = null;
            _requests = [];
        }
    }

    // Unwrap a ValidationProblem's `errors` values (the by-design refusal, e.g. "Only active suppliers can
    // be suspended.") — the envelope's generic title otherwise makes a refused transition look like a dead button.
    private static async Task<string> ReadFailureAsync(HttpResponseMessage response)
    {
        var raw = await response.Content.ReadAsStringAsync();
        try
        {
            using var doc = JsonDocument.Parse(raw);
            if (doc.RootElement.ValueKind == JsonValueKind.Object
                && doc.RootElement.TryGetProperty("errors", out var errors)
                && errors.ValueKind == JsonValueKind.Object)
            {
                var messages = errors.EnumerateObject()
                    .Where(p => p.Value.ValueKind == JsonValueKind.Array)
                    .SelectMany(p => p.Value.EnumerateArray())
                    .Where(v => v.ValueKind == JsonValueKind.String)
                    .Select(v => v.GetString()!)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .ToList();
                if (messages.Count > 0)
                {
                    return string.Join(" ", messages);
                }
            }
        }
        catch (JsonException)
        {
            // Not JSON — fall through to the shared humanizer.
        }

        return GatewayError.Humanize(raw);
    }

