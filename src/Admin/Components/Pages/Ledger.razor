@page "/ledger"
@attribute [Authorize(Roles = "admin")]
@rendermode AdminRenderModes.InteractiveServerNoPrerender
@inject GatewayClient Gateway

<h1>@L["Ledger.Title"]</h1>

@* Balances per (account, currency): a balance is only meaningful within one currency (minor units are
   not comparable across currencies), so accounts are grouped by currency and the trial balance
   (Σ debits = Σ credits) is checked PER currency. *@
<h2 style="margin:1.2rem 0 .4rem;">@L["Ledger.Balances"]</h2>
@if (_balances is null) { <p>@L["Common.Loading"]</p> }
else if (_balances.Count == 0) { <p style="color:#9ca3af;">—</p> }
else
{
    @foreach (var grp in _balances.GroupBy(b => b.Currency))
    {
        var dr = grp.Sum(b => b.DebitMinor);
        var cr = grp.Sum(b => b.CreditMinor);
        var balanced = dr == cr;
        <div style="margin-bottom:1rem; border:1px solid #e5e7eb; border-radius:8px; padding:.6rem .9rem;">
            <div style="display:flex; gap:.6rem; align-items:baseline; margin-bottom:.3rem;">
                <strong>@grp.Key</strong>
                <span style="font-size:.8rem; color:@(balanced ? "#047857" : "#b91c1c");">@(balanced ? L["Ledger.Balanced"] : L["Ledger.OutOfBalance"])</span>
            </div>
            <table style="border-collapse:collapse; width:100%; font-size:.88rem;">
                <thead><tr><th style="text-align:left;">@L["Ledger.Col.Account"]</th><th style="text-align:right;">@L["Ledger.Col.Debit"]</th><th style="text-align:right;">@L["Ledger.Col.Credit"]</th><th style="text-align:right;">@L["Ledger.Col.Net"]</th></tr></thead>
                <tbody>
                @foreach (var b in grp)
                {
                    <tr style="border-top:1px solid #f3f4f6;">
                        <td><code style="font-size:.8rem;">@b.AccountCode</code></td>
                        <td style="text-align:right;">@Money.Amount(b.DebitMinor, grp.Key)</td>
                        <td style="text-align:right;">@Money.Amount(b.CreditMinor, grp.Key)</td>
                        <td style="text-align:right; font-weight:600;">@Money.Amount(b.NetMinor, grp.Key) @grp.Key</td>
                    </tr>
                }
                </tbody>
            </table>
            @{
                // Per-store refunds reverse the store's OWN revenue/tax accounts (ADR-0040) — they show
                // as debits on revenue.*/tax.* rather than a separate account, so surface the total here.
                var refunds = grp.Where(b => b.AccountCode.StartsWith("revenue.", StringComparison.Ordinal)
                        || b.AccountCode.StartsWith("tax.", StringComparison.Ordinal))
                    .Sum(b => b.DebitMinor);
            }
            @if (refunds > 0)
            {
                <div style="font-size:.8rem; color:#b45309; margin-top:.35rem;" title="@L["Ledger.Refunds.Tip"]">
                    @L["Ledger.Refunds"]: @Money.Amount(refunds, grp.Key) @grp.Key
                </div>
            }
        </div>
    }
}

<h2 style="margin:1.4rem 0 .4rem;">@L["Ledger.Entries"]</h2>
<div style="display:flex; gap:.6rem; align-items:end; flex-wrap:wrap; margin:.2rem 0 .8rem;">
    <label style="font-size:.8rem; color:#6b7280;">@L["Ledger.Filter.From"]<br />
        <input type="date" @bind="_start" style="padding:.35rem;" title="@L["Ledger.Filter.From.Tip"]" /></label>
    <label style="font-size:.8rem; color:#6b7280;">@L["Ledger.Filter.To"]<br />
        <input type="date" @bind="_end" style="padding:.35rem;" title="@L["Ledger.Filter.To.Tip"]" /></label>
    <label style="font-size:.8rem; color:#6b7280;">@L["Ledger.Filter.Storefront"]<br />
        <select @bind="_storefrontId" style="padding:.35rem; min-width:12rem;" title="@L["Ledger.Filter.Storefront.Tip"]">
            <option value="">@L["Ledger.Filter.AllStorefronts"]</option>
            @if (_storefronts is not null)
            {
                @foreach (var s in _storefronts)
                {
                    <option value="@s.Id">@s.Name (@s.Currency)</option>
                }
            }
        </select></label>
    <label style="font-size:.8rem; color:#6b7280;">@L["Ledger.Filter.Currency"]<br />
        <select @bind="_currency" style="padding:.35rem;" title="@L["Ledger.Filter.Currency.Tip"]">
            <option value="">@L["Ledger.Filter.AllCurrencies"]</option>
            @foreach (var c in CurrencyOptions)
            {
                <option value="@c">@c</option>
            }
        </select></label>
    <button @onclick="ApplyFilters" disabled="@_loadingEntries" style="padding:.4rem .9rem;">@L["Ledger.Filter.Apply"]</button>
    <button @onclick="ClearFilters" disabled="@_loadingEntries" title="@L["Ledger.Filter.Clear.Tip"]" style="padding:.4rem .9rem;">@L["Ledger.Filter.Clear"]</button>
</div>
@if (_entries is null) { <p>@L["Common.Loading"]</p> }
else
{
    <table style="border-collapse:collapse;width:100%;">
        <thead><tr><th style="text-align:left;">@L["Ledger.Col.When"]</th><th style="text-align:left;">@L["Ledger.Col.Description"]</th><th style="text-align:left;">@L["Ledger.Col.Storefront"]</th><th>@L["Ledger.Col.Reference"]</th><th>@L["Ledger.Col.Currency"]</th><th style="text-align:right;">@L["Ledger.Col.Amount"]</th></tr></thead>
        <tbody>
        @foreach (var e in _entries)
        {
            var refunded = RefundedMinor(e);
            var open = _expanded.Contains(e.Id);
            var (amount, kind) = Classify(e);
            @* Amount coloured by direction: green = money in, red = money out, amber = refund (distinct
               from an outgoing payment). Expands to a per-line breakdown; refund lines are highlighted. *@
            <tr style="border-top:1px solid #e5e7eb;">
                <td style="white-space:nowrap;">@e.CreatedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@e.Description</td>
                <td>@StorefrontName(e)</td>
                <td style="text-align:center;">@e.Reference</td>
                <td style="text-align:center;">@e.Currency</td>
                <td style="text-align:right;">
                    <button @onclick="() => Toggle(e.Id)" title="@L["Ledger.Entry.Breakdown.Tip"]"
                            style="background:none;border:0;cursor:pointer;font:inherit;font-weight:600;color:@KindColor(kind);">
                        <span aria-hidden style="font-weight:400;color:#9ca3af;">@(open ? "▾" : "▸")</span> @KindSign(kind)@Money.Amount(amount, e.Currency) @e.Currency
                    </button>
                </td>
            </tr>
            @if (open)
            {
                <tr style="background:#f9fafb;">
                    <td colspan="6" style="padding:.5rem .9rem;">
                        <table style="border-collapse:collapse; font-size:.82rem; width:100%; max-width:34rem;">
                            <thead><tr><th style="text-align:left;">@L["Ledger.Col.Account"]</th><th style="text-align:right;">@L["Ledger.Col.Debit"]</th><th style="text-align:right;">@L["Ledger.Col.Credit"]</th></tr></thead>
                            <tbody>
                            @foreach (var l in e.Lines)
                            {
                                // Highlight the line(s) that define this entry, in the entry's own colour —
                                // matching the Amount: refund = revenue/tax debit (amber), sale = revenue/tax
                                // credit (green), outgoing = cash credit (red).
                                var highlight = IsHighlightLine(l, kind);
                                <tr style="border-top:1px solid #f3f4f6; @(highlight ? $"color:{KindColor(kind)};font-weight:600;" : "")">
                                    <td><code style="font-size:.78rem;">@l.AccountCode</code></td>
                                    <td style="text-align:right;">@(l.DebitMinor > 0 ? Money.Amount(l.DebitMinor, e.Currency) : "")</td>
                                    <td style="text-align:right;">@(l.CreditMinor > 0 ? Money.Amount(l.CreditMinor, e.Currency) : "")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        @if (refunded > 0)
                        {
                            <div style="font-size:.8rem; color:#b45309; margin-top:.35rem;" title="@L["Ledger.Refunds.Tip"]">@L["Ledger.Refunds"]: @Money.Amount(refunded, e.Currency) @e.Currency</div>
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
}
@code {
    private const string Tenant = "00000000-0000-0000-0000-000000000001";
    private List<EntryDto>? _entries;
    private List<BalanceDto>? _balances;
    private List<StorefrontDto>? _storefronts;
    private readonly HashSet<Guid> _expanded = [];
    private bool _loadingEntries;

    // Journal-entry filters (server-side — the endpoint caps at 200 rows, so filtering the full set on the
    // server, not the fetched page, is what makes the filter meaningful).
    private DateOnly? _start;
    private DateOnly? _end;
    private string _storefrontId = "";
    private string _currency = "";

    // Currency options come from the currencies actually present in the ledger balances — no point offering
    // a currency with no entries.
    private IEnumerable<string> CurrencyOptions =>
        (_balances ?? []).Select(b => b.Currency).Distinct().OrderBy(c => c, StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        _balances = await Gateway.GetListAsync<BalanceDto>("/api/payments/admin/ledger/balances");
        _storefronts = await SafeStorefronts();
        await LoadEntries();
    }

    private async Task<List<StorefrontDto>> SafeStorefronts()
    {
        try { return await Gateway.GetListAsync<StorefrontDto>($"/api/catalog/admin/storefronts?tenantId={Tenant}"); }
        catch { return []; }
    }

    // Re-fetch the entries with the current filters as query-string params. Empty/unset filters are omitted.
    private async Task LoadEntries()
    {
        _loadingEntries = true;
        var q = new List<string>();
        if (_start is { } s) { q.Add($"start={s:yyyy-MM-dd}"); }
        if (_end is { } e) { q.Add($"end={e:yyyy-MM-dd}"); }
        if (!string.IsNullOrEmpty(_storefrontId)) { q.Add($"storefrontId={_storefrontId}"); }
        if (!string.IsNullOrWhiteSpace(_currency)) { q.Add($"currency={Uri.EscapeDataString(_currency)}"); }
        var url = "/api/payments/admin/ledger/entries" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
        _entries = await Gateway.GetListAsync<EntryDto>(url);
        _expanded.Clear();
        _loadingEntries = false;
    }

    private Task ApplyFilters() => LoadEntries();

    private async Task ClearFilters()
    {
        _start = _end = null;
        _storefrontId = _currency = "";
        await LoadEntries();
    }

    private void Toggle(Guid id)
    {
        if (!_expanded.Remove(id))
        {
            _expanded.Add(id);
        }
    }

    // The refunded amount in an entry: debits to revenue.*/tax.* — how a per-store refund reverses the
    // store's own revenue/tax accounts (ADR-0040). Zero for sales (which credit those accounts).
    private static long RefundedMinor(EntryDto e) => e.Lines
        .Where(l => l.DebitMinor > 0
            && (l.AccountCode.StartsWith("revenue.", StringComparison.Ordinal) || l.AccountCode.StartsWith("tax.", StringComparison.Ordinal)))
        .Sum(l => l.DebitMinor);

    private enum EntryKind { Refund, Incoming, Outgoing, Neutral }

    // Classify an entry and derive its transaction amount. The amount is the revenue+tax movement, NOT
    // Σ debits — an entry contains a receivable clearing line (debit AND credit for the gross) plus fees,
    // so Σ debits double-counts. A refund reverses revenue/tax (debit) → amber; a sale posts revenue/tax
    // (credit) → green (gross = net + tax). Sale/refund own the revenue/tax lines, so they are matched
    // first (a sale's own processing-fee expense line must not reclassify it). Entries with no revenue/tax
    // are cost movements: an expense booked (carrier cost / COGS accrual, net expense debit) or a write-off
    // reclass (expense→expense, nets to zero but recognises a loss) → red; a COGS reversal on restock
    // (expense credited back) → green. Otherwise fall back to net cash direction (e.g. supplier payout → red).
    private static (long Amount, EntryKind Kind) Classify(EntryDto e)
    {
        long revTaxDebit = 0, revTaxCredit = 0, cashDebit = 0, cashCredit = 0, expenseDebit = 0, expenseCredit = 0, writeoffDebit = 0, chargebackFeeDebit = 0;
        foreach (var l in e.Lines)
        {
            if (l.AccountCode.StartsWith("revenue.", StringComparison.Ordinal) || l.AccountCode.StartsWith("tax.", StringComparison.Ordinal))
            {
                revTaxDebit += l.DebitMinor;
                revTaxCredit += l.CreditMinor;
            }
            else if (l.AccountCode.StartsWith("cash.", StringComparison.Ordinal))
            {
                cashDebit += l.DebitMinor;
                cashCredit += l.CreditMinor;
            }
            else if (l.AccountCode.StartsWith("expense.", StringComparison.Ordinal))
            {
                expenseDebit += l.DebitMinor;
                expenseCredit += l.CreditMinor;
                if (l.AccountCode.StartsWith("expense.writeoffs", StringComparison.Ordinal))
                {
                    writeoffDebit += l.DebitMinor;
                }

                if (l.AccountCode.EndsWith("_chargeback_fees", StringComparison.Ordinal))
                {
                    chargebackFeeDebit += l.DebitMinor;
                }
            }
        }

        // A chargeback reverses revenue/tax (debit) like a refund AND books a dispute fee — the fee line
        // distinguishes it from a plain refund. Classify it money-out (red), sized by the total cash that
        // left the provider (disputed gross + fee), so it never reads as a benign amber refund.
        if (chargebackFeeDebit > 0)
        {
            return (cashCredit, EntryKind.Outgoing);
        }

        if (revTaxDebit > 0)
        {
            return (revTaxDebit, EntryKind.Refund); // gross refunded = revenue + tax reversed
        }

        if (revTaxCredit > 0)
        {
            return (revTaxCredit, EntryKind.Incoming); // sale gross = revenue + tax
        }

        // Cost entries (no revenue/tax): carrier-cost + COGS accruals book a net expense debit (money owed
        // out → red); a Storage write-off reclasses COGS→write-off (expense-neutral, but the loss is a cost
        // event → red, sized by the write-off debit); a Restock COGS reversal credits expense back → green.
        var expenseNet = expenseDebit - expenseCredit;
        if (expenseNet > 0)
        {
            return (expenseNet, EntryKind.Outgoing);
        }

        if (writeoffDebit > 0)
        {
            return (writeoffDebit, EntryKind.Outgoing);
        }

        if (expenseNet < 0)
        {
            return (-expenseNet, EntryKind.Incoming);
        }

        var net = cashDebit - cashCredit;
        if (net > 0)
        {
            return (net, EntryKind.Incoming);
        }

        return net < 0 ? (-net, EntryKind.Outgoing) : (e.Lines.Sum(l => l.DebitMinor), EntryKind.Neutral);
    }

    // The breakdown line that carries the entry's meaning, coloured to match the Amount: a refund reverses
    // revenue/tax (debit), a sale posts revenue/tax (credit), an outgoing payment credits cash.
    private static bool IsHighlightLine(LineDto l, EntryKind kind)
    {
        var isRevTax = l.AccountCode.StartsWith("revenue.", StringComparison.Ordinal) || l.AccountCode.StartsWith("tax.", StringComparison.Ordinal);
        var isCash = l.AccountCode.StartsWith("cash.", StringComparison.Ordinal);
        var isExpense = l.AccountCode.StartsWith("expense.", StringComparison.Ordinal);
        return kind switch
        {
            EntryKind.Refund => isRevTax && l.DebitMinor > 0,
            // Incoming also covers a COGS reversal (expense credited back on restock).
            EntryKind.Incoming => (isRevTax && l.CreditMinor > 0) || (isCash && l.DebitMinor > 0) || (isExpense && l.CreditMinor > 0),
            // Outgoing also covers a cost accrual / write-off (the expense debit carries the meaning).
            EntryKind.Outgoing => (isCash && l.CreditMinor > 0) || (isExpense && l.DebitMinor > 0),
            _ => false,
        };
    }

    private static string KindColor(EntryKind kind) => kind switch
    {
        EntryKind.Incoming => "#047857", // green — money in
        EntryKind.Outgoing => "#b91c1c", // red — money out
        EntryKind.Refund => "#b45309",   // amber — refund (distinct from a plain outgoing)
        _ => "#6b7280",                  // grey — no cash movement (e.g. accrual)
    };

    private static string KindSign(EntryKind kind) => kind switch
    {
        EntryKind.Incoming => "+",
        EntryKind.Outgoing => "−",
        EntryKind.Refund => "−",
        _ => "",
    };

    public record BalanceDto(string AccountCode, string Currency, long DebitMinor, long CreditMinor, long NetMinor);
    // The storefront an entry belongs to, derived from the store token (store-{id:N}) its line account codes
    // carry — one order posts one store's lines (revenue.store-…, cash.store-….stripe, …). Mapped to the
    // store name via the loaded list; shared/legacy accounts have no token → "—", an unknown/archived store
    // shows a short id.
    private static readonly System.Text.RegularExpressions.Regex StoreToken =
        new("store-([0-9a-fA-F]{32})", System.Text.RegularExpressions.RegexOptions.Compiled);
    private string StorefrontName(EntryDto e)
    {
        foreach (var l in e.Lines)
        {
            var m = StoreToken.Match(l.AccountCode);
            if (m.Success && Guid.TryParseExact(m.Groups[1].Value, "N", out var sid))
            {
                return _storefronts?.FirstOrDefault(s => s.Id == sid)?.Name ?? sid.ToString()[..8];
            }
        }

        return "—";
    }

    public record LineDto(string AccountCode, long DebitMinor, long CreditMinor);
    public record EntryDto(Guid Id, string Description, string Reference, string Currency, DateTimeOffset CreatedAt, List<LineDto> Lines);
    // Subset of the catalog admin storefront list — just what the storefront filter dropdown needs.
    public record StorefrontDto(Guid Id, string Name, string Currency);
}
