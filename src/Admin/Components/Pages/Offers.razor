@page "/offers"
@attribute [Authorize(Roles = "admin")]
@inject GatewayClient Gateway
@rendermode AdminRenderModes.InteractiveServerNoPrerender

<h1>@L["Offers.Title"]</h1>
<p style="color:#6b7280;">@L["Offers.Intro"]</p>

<div style="display:flex; gap:.6rem; align-items:end; margin:1rem 0; flex-wrap:wrap;">
    <label>@L["Common.TenantId"]
        <input @bind="_tenantId" title="@L["Offers.TenantId.Tip"]" style="width:23rem; display:block;" />
    </label>
    <label>@L["Offers.ProductFilter"]
        <input @bind="_productFilter" title="@L["Offers.ProductFilter.Tip"]" style="width:23rem; display:block;" />
    </label>
    <button @onclick="LoadAsync" title="@L["Common.Load.Tip"]" style="padding:.45rem .8rem;">@L["Common.Load"]</button>
    <button @onclick="NewOffer" title="@L["Offers.New.Tip"]" style="padding:.45rem .8rem; background:#111827; color:#fff; border:0; border-radius:5px;">@L["Offers.NewButton"]</button>
</div>

@if (_error is not null) { <p style="color:#b91c1c; white-space:pre-wrap;">@_error</p> }
@if (_status is not null) { <p style="color:#047857;">@_status</p> }

@if (_offers is not null)
{
    <table style="width:100%; border-collapse:collapse; font-size:.9rem;">
        <thead>
            <tr style="text-align:left; border-bottom:2px solid #e5e7eb;"><th style="padding:.4rem;">@L["Offers.Col.Product"]</th><th>@L["Offers.Col.Title"]</th><th>@L["Offers.Col.Variant"]</th><th>@L["Offers.Col.Supplier"]</th><th>@L["Offers.Col.Supply"]</th><th>@L["Offers.Col.Pricing"]</th><th>@L["Offers.Col.Price"]</th><th>@L["Offers.Col.Storefront"]</th><th>@L["Offers.Col.Window"]</th><th>@L["Offers.Col.Priority"]</th><th>@L["Common.Status"]</th><th>@L["Common.Actions"]</th></tr>
        </thead>
        <tbody>
        @foreach (var offer in _offers)
        {
            <tr style="border-bottom:1px solid #f3f4f6;">
                <td style="padding:.4rem;"><code>@Short(offer.ProductId)</code></td>
                <td>@offer.ProductTitle</td>
                <td><code>@(offer.VariantId is null ? L["Suppliers.Offer.AllVariants"] : Short(offer.VariantId.Value))</code></td>
                <td><code>@Short(offer.SupplierId)</code></td>
                <td>@offer.SupplyCategory / @offer.FulfilmentType</td>
                <td>@offer.PricingModel / @offer.BillingPeriod @TierSummary(offer)</td>
                <td style="text-align:right;">@offer.PriceMinor @offer.Currency</td>
                <td>@StorefrontLabel(offer.StorefrontId)</td>
                <td style="white-space:nowrap;">@WindowLabel(offer)</td>
                <td style="text-align:center;">@offer.Priority</td>
                <td>@offer.Status</td>
                <td style="white-space:nowrap;"><button @onclick="() => Edit(offer)" title="@L["Offers.Edit.Tip"]">@L["Common.Edit"]</button></td>
            </tr>
        }
        </tbody>
    </table>
    @if (_offers.Count == 0) { <p style="color:#9ca3af;">@L["Offers.Empty"]</p> }

    @if (_showForm)
    {
    <div style="position:fixed; inset:0; background:rgba(17,24,39,.55); display:flex; align-items:flex-start; justify-content:center; padding:2rem 1rem; z-index:1000; overflow:auto;" @onclick="CloseForm">
    <section @onclick:stopPropagation="true" style="border:1px solid #e5e7eb; border-radius:8px; padding:1rem 1.25rem; width:100%; max-width:900px; max-height:90vh; overflow:auto; background:#fff; box-shadow:0 10px 40px rgba(0,0,0,.25);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <h2 style="margin-top:0; font-size:1.1rem;">@(_editingId is null ? L["Offers.New"] : L["Offers.EditHeading"])</h2>
            <button @onclick="CloseForm" title="@L["Common.Close.Tip"]" style="border:0; background:none; font-size:1.3rem; line-height:1; cursor:pointer; color:#6b7280;">✕</button>
        </div>
        @if (_editingId is not null || !string.IsNullOrWhiteSpace(_form.ProductTitle))
        {
            <p style="margin:.2rem 0 .8rem; color:#374151;"><strong>@L["Offers.Field.Title"]:</strong> @(string.IsNullOrWhiteSpace(_form.ProductTitle) ? "—" : _form.ProductTitle)</p>
        }
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:.6rem;">
            @if (_editingId is not null)
            {
                @* Product / Variant / Supplier are immutable after creation — show the resolved names read-only. *@
                <label>@L["Offers.Field.Product"] <input value="@(string.IsNullOrWhiteSpace(_form.ProductTitle) ? Short(ParseGuid(_form.ProductId)) : _form.ProductTitle)" disabled title="@L["Offers.Field.Product.Tip"]" style="width:100%;" /></label>
                <label>@L["Offers.Field.Variant"] <input value="@(string.IsNullOrWhiteSpace(_form.VariantSku) ? L["Offers.Variant.All"] : _form.VariantSku)" disabled title="@L["Offers.Field.Variant.Tip"]" style="width:100%;" /></label>
                <label>@L["Offers.Field.Supplier"] <input value="@SupplierName(_form.SupplierId)" disabled title="@L["Offers.Field.Supplier.Tip"]" style="width:100%;" /></label>
            }
            else
            {
                <label>@L["Offers.Field.Product"]
                    <input @bind="_productSearch" @bind:event="oninput" placeholder="@L["Offers.Field.ProductSearch"]" title="@L["Offers.Field.ProductSearch.Tip"]" style="width:100%; margin-bottom:.25rem;" />
                    <select value="@_form.ProductId" @onchange="OnProductChanged" title="@L["Offers.Field.Product.Tip"]" style="width:100%;">
                        <option value="">@(_products is null ? L["Offers.Loading"] : _products.Count == 0 ? L["Offers.Product.Empty"] : L["Offers.Product.Choose"])</option>
                        @if (_products is not null)
                        {
                            @foreach (var p in FilteredProducts())
                            {
                                <option value="@p.Id">@p.Title — @Short(p.Id)</option>
                            }
                        }
                    </select>
                </label>
                <label>@L["Offers.Field.Variant"]
                    <select @bind="_form.VariantId" disabled="@(!Guid.TryParse(_form.ProductId, out _))" title="@L["Offers.Field.Variant.Tip"]" style="width:100%;">
                        <option value="">@L["Offers.Variant.All"]</option>
                        @if (_variants is not null)
                        {
                            @foreach (var v in _variants)
                            {
                                <option value="@v.Id">@v.Sku</option>
                            }
                        }
                    </select>
                </label>
                <label>@L["Offers.Field.Supplier"]
                    <select @bind="_form.SupplierId" title="@L["Offers.Field.Supplier.Tip"]" style="width:100%;">
                        <option value="">@(_suppliers is null ? L["Offers.Loading"] : _suppliers.Count == 0 ? L["Offers.Supplier.Empty"] : L["Offers.Supplier.Choose"])</option>
                        @if (_suppliers is not null)
                        {
                            @foreach (var s in _suppliers)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        }
                    </select>
                </label>
            }
            <label>@L["Offers.Field.SupplyCategory"]
                <select @bind="_form.SupplyCategory" disabled="@(_editingId is not null)" title="@L["Offers.Field.SupplyCategory.Tip"]" style="width:100%;"><option value="1">@L["Catalog.Type.Physical"]</option><option value="2">@L["Catalog.Type.Digital"]</option><option value="3">@L["Catalog.Type.Service"]</option></select>
            </label>
            <label>@L["Offers.Field.FulfilmentType"]
                <select @bind="_form.FulfilmentType" disabled="@(_editingId is not null)" title="@L["Offers.Field.FulfilmentType.Tip"]" style="width:100%;"><option value="1">@L["Offers.Fulfilment.Dropship"]</option><option value="2">@L["Offers.Fulfilment.Warehouse"]</option><option value="3">@L["Offers.Fulfilment.DigitalDownload"]</option><option value="4">@L["Offers.Fulfilment.Subscription"]</option><option value="5">@L["Offers.Fulfilment.Usage"]</option><option value="6">@L["Offers.Fulfilment.ManualService"]</option></select>
            </label>
            <label>@L["Offers.Field.PriceMinor"] <input type="number" @bind="_form.PriceMinor" title="@L["Offers.Field.PriceMinor.Tip"]" style="width:100%;" /></label>
            <label>@L["Offers.Field.Currency"] <CurrencySelect @bind-Value="_form.Currency" style="width:100%;" /></label>
            <label>@L["Offers.Field.Priority"] <input type="number" @bind="_form.Priority" title="@L["Offers.Field.Priority.Tip"]" style="width:100%;" /></label>
            <label>@L["Offers.Field.PricingModel"]
                <select @bind="_form.PricingModel" title="@L["Offers.Field.PricingModel.Tip"]" style="width:100%;"><option value="1">@L["Offers.PricingModel.OneTime"]</option><option value="2">@L["Offers.PricingModel.Subscription"]</option><option value="3">@L["Offers.PricingModel.UsageBased"]</option><option value="4">@L["Offers.PricingModel.Tiered"]</option></select>
            </label>
            <label>@L["Offers.Field.BillingPeriod"]
                <select @bind="_form.BillingPeriod" title="@L["Offers.Field.BillingPeriod.Tip"]" style="width:100%;"><option value="1">@L["Offers.BillingPeriod.Once"]</option><option value="2">@L["Offers.BillingPeriod.Monthly"]</option><option value="3">@L["Offers.BillingPeriod.Yearly"]</option></select>
            </label>
            @if (_editingId is not null)
            {
                <label style="display:flex; gap:.4rem; align-items:center;"><input type="checkbox" @bind="_form.Active" title="@L["Offers.Field.Active.Tip"]" /> @L["Common.Active"]</label>
            }
        </div>

        @* Supplier cost is read-only here — it is edited only on the Suppliers page. *@
        @if (_editingId is not null)
        {
            <p style="margin:.6rem 0 0; color:#374151;" title="@L["Offers.Field.SupplierCost.Tip"]"><strong>@L["Offers.Field.SupplierCost"]:</strong> @_form.SupplierCostMinor @_form.Currency</p>
        }

        <fieldset style="border:1px solid #e5e7eb; padding:.6rem; margin-top:.8rem;">
            <legend>@L["Offers.Scope.Legend"]</legend>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:.6rem;">
                <label>@L["Offers.Field.Storefront"]
                    <select @bind="_form.StorefrontId" title="@L["Offers.Field.Storefront.Tip"]" style="width:100%;">
                        <option value="">@L["Offers.Storefront.All"]</option>
                        @if (_storefronts is not null)
                        {
                            @foreach (var s in _storefronts)
                            {
                                <option value="@s.Id">@s.Name (@s.Currency)</option>
                            }
                        }
                    </select>
                </label>
                <label>@L["Offers.Field.ActiveFrom"] <input type="date" @bind="_form.ActiveFrom" title="@L["Offers.Field.ActiveFrom.Tip"]" style="width:100%;" /></label>
                <label>@L["Offers.Field.ActiveUntil"] <input type="date" @bind="_form.ActiveUntil" title="@L["Offers.Field.ActiveUntil.Tip"]" style="width:100%;" /></label>
            </div>
        </fieldset>

        <fieldset style="border:1px solid #e5e7eb; padding:.6rem; margin-top:.8rem;">
            <legend>@L["Offers.Tiers"]</legend>
            @foreach (var tier in _form.Tiers)
            {
                <div style="display:flex; gap:.4rem; margin-bottom:.35rem;">
                    <label>@L["Offers.Tier.FromQty"] <input type="number" @bind="tier.FromQuantity" title="@L["Offers.Tier.FromQty.Tip"]" style="width:7rem;" /></label>
                    <label>@L["Offers.Tier.UnitPrice"] <input type="number" @bind="tier.UnitPriceMinor" title="@L["Offers.Tier.UnitPrice.Tip"]" style="width:10rem;" /></label>
                    <button @onclick="() => _form.Tiers.Remove(tier)" title="@L["Offers.Tier.Remove.Tip"]" style="color:#b91c1c;">✕</button>
                </div>
            }
            <button @onclick="() => _form.Tiers.Add(new())" title="@L["Offers.Tier.Add.Tip"]">@L["Offers.Tier.Add"]</button>
        </fieldset>

        <div style="margin-top:.8rem; display:flex; gap:.5rem;"><button @onclick="Save" title="@L["Offers.Save.Tip"]" style="padding:.45rem .9rem; background:#111827; color:#fff; border:0; border-radius:5px;">@L["Offers.Save"]</button><button @onclick="ResetForm" title="@L["Common.Clear.Tip"]">@L["Common.Clear"]</button><button @onclick="CloseForm" title="@L["Common.Cancel.Tip"]">@L["Common.Cancel"]</button></div>
    </section>
    </div>
    }
}

@code {
    private const string Base = "/api/catalog/admin/offers";
    private string _tenantId = "00000000-0000-0000-0000-000000000001";
    private string _productFilter = string.Empty;
    private List<OfferDto>? _offers;
    private List<StorefrontDto>? _storefronts;
    private List<ProductListItem>? _products;
    private List<SupplierOption>? _suppliers;
    private List<VariantOption>? _variants;
    private string _productSearch = string.Empty;
    private string? _status;
    private string? _error;
    private Guid? _editingId;
    private bool _showForm;
    private readonly OfferForm _form = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = _status = null;
        try
        {
            var query = $"tenantId={Uri.EscapeDataString(_tenantId)}";
            if (!string.IsNullOrWhiteSpace(_productFilter)) query += $"&product={Uri.EscapeDataString(_productFilter)}";
            _offers = await Gateway.GetListAsync<OfferDto>($"{Base}?{query}");
            // Storefronts feed the scope picker + the table labels; a failure here must not block offers.
            _storefronts = await SafeStorefronts();
            // Products + suppliers feed the New-offer dropdowns; a failure here must not block the list/modal.
            _products = await SafeProducts();
            _suppliers = await SafeSuppliers();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Save()
    {
        _error = _status = null;
        if (!Guid.TryParse(_tenantId, out var tenant)) { _error = L["Offers.Error.TenantGuid"]; return; }
        if (!Guid.TryParse(_form.ProductId, out var product)) { _error = L["Offers.Error.ProductGuid"]; return; }
        if (!Guid.TryParse(_form.SupplierId, out var supplier)) { _error = L["Offers.Error.SupplierGuid"]; return; }
        Guid? variant = Guid.TryParse(_form.VariantId, out var parsedVariant) ? parsedVariant : null;
        var tiers = _form.Tiers.Where(t => t.FromQuantity > 0).Select(t => new { t.FromQuantity, t.UnitPriceMinor }).ToList();

        Guid? storefrontId = Guid.TryParse(_form.StorefrontId, out var sf) ? sf : null;
        DateTimeOffset? activeFrom = _form.ActiveFrom is { } from ? new DateTimeOffset(from, TimeSpan.Zero) : null;
        // Include the whole ActiveUntil day: an end date of the 5th means "effective through end of the 5th".
        DateTimeOffset? activeUntil = _form.ActiveUntil is { } until ? new DateTimeOffset(until, TimeSpan.Zero).AddDays(1).AddTicks(-1) : null;

        object body = _editingId is null
            ? new { tenantId = tenant, productId = product, variantId = variant, supplierId = supplier, supplyCategory = _form.SupplyCategory, fulfilmentType = _form.FulfilmentType, priceMinor = _form.PriceMinor, currency = _form.Currency, priority = _form.Priority, pricingModel = _form.PricingModel, billingPeriod = _form.BillingPeriod, tiers, storefrontId, activeFrom, activeUntil }
            : new { priceMinor = _form.PriceMinor, priority = _form.Priority, active = _form.Active, pricingModel = _form.PricingModel, billingPeriod = _form.BillingPeriod, tiers, applyScope = true, storefrontId, activeFrom, activeUntil };
        var response = _editingId is null ? await Gateway.PostAsync(Base, body) : await Gateway.PutAsync($"{Base}/{_editingId}", body);
        if (response.IsSuccessStatusCode) { ResetForm(); _showForm = false; await LoadAsync(); _status = L["Offers.Status.Saved"]; } // LoadAsync clears _status/_error, so set the confirmation AFTER the reload
        else { _error = await response.Content.ReadAsStringAsync(); }
    }

    private void NewOffer()
    {
        ResetForm();
        _showForm = true;
    }

    private void CloseForm()
    {
        ResetForm();
        _showForm = false;
    }

    private void Edit(OfferDto offer)
    {
        _editingId = offer.Id;
        _showForm = true;
        _form.ProductTitle = offer.ProductTitle;
        _form.ProductId = offer.ProductId.ToString(); _form.VariantId = offer.VariantId?.ToString() ?? string.Empty; _form.SupplierId = offer.SupplierId.ToString(); _form.VariantSku = offer.VariantSku ?? string.Empty;
        _form.SupplyCategory = SupplyCategoryValue(offer.SupplyCategory); _form.FulfilmentType = FulfilmentTypeValue(offer.FulfilmentType); _form.PricingModel = PricingModelValue(offer.PricingModel); _form.BillingPeriod = BillingPeriodValue(offer.BillingPeriod);
        _form.PriceMinor = offer.PriceMinor; _form.Currency = offer.Currency; _form.Priority = offer.Priority; _form.Active = offer.Status == "Active"; _form.SupplierCostMinor = offer.SupplierCostMinor;
        _form.StorefrontId = offer.StorefrontId?.ToString() ?? string.Empty;
        _form.ActiveFrom = offer.ActiveFrom?.UtcDateTime.Date; _form.ActiveUntil = offer.ActiveUntil?.UtcDateTime.Date;
        _form.Tiers.Clear(); foreach (var tier in offer.Tiers) _form.Tiers.Add(new TierForm { FromQuantity = tier.FromQuantity, UnitPriceMinor = tier.UnitPriceMinor });
    }

    private void ResetForm()
    {
        _editingId = null; _form.ProductTitle = string.Empty; _form.ProductId = string.Empty; _form.VariantId = string.Empty; _form.VariantSku = string.Empty; _form.SupplierId = string.Empty; _form.SupplyCategory = 1; _form.FulfilmentType = 2; _form.PriceMinor = 0; _form.Currency = "EUR"; _form.Priority = 0; _form.PricingModel = 1; _form.BillingPeriod = 1; _form.Active = true; _form.SupplierCostMinor = 0; _form.StorefrontId = string.Empty; _form.ActiveFrom = null; _form.ActiveUntil = null; _form.Tiers.Clear();
        _variants = null; _productSearch = string.Empty;
    }

    // The New-offer dropdowns are populated from live data; failures degrade to an empty list (the modal
    // still opens) rather than blocking the page.
    private async Task<List<ProductListItem>> SafeProducts()
    {
        // ~200 products live; ask for the whole page so the picker lists them all (server clamps at 200).
        try { return await Gateway.GetListAsync<ProductListItem>("/api/catalog/admin/products?pageSize=200"); }
        catch { return []; }
    }

    private async Task<List<SupplierOption>> SafeSuppliers()
    {
        // A supplier is a tenant entity that has started onboarding (OnboardingState non-null) — same filter
        // the Suppliers page uses. Show trading name, falling back to legal name.
        try
        {
            var entities = await Gateway.GetListAsync<SupplierSummary>($"/api/entity/entities?tenantId={Uri.EscapeDataString(_tenantId)}");
            return entities.Where(e => e.OnboardingState is not null)
                .Select(e => new SupplierOption(e.Id, string.IsNullOrWhiteSpace(e.TradingName) ? e.LegalName : e.TradingName!))
                .OrderBy(s => s.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
        catch { return []; }
    }

    // Product selection drives the dependent variant dropdown: reset the variant and reload the SKUs.
    private async Task OnProductChanged(ChangeEventArgs e)
    {
        _form.ProductId = e.Value?.ToString() ?? string.Empty;
        _form.VariantId = string.Empty;
        _form.ProductTitle = _products?.FirstOrDefault(p => p.Id.ToString() == _form.ProductId)?.Title ?? string.Empty;
        await LoadVariantsAsync();
    }

    private async Task LoadVariantsAsync()
    {
        _variants = null;
        if (!Guid.TryParse(_form.ProductId, out var productId)) { _variants = []; return; }
        try
        {
            var product = await Gateway.GetAsync<ProductEditorDto>($"/api/catalog/admin/products/{productId}");
            _variants = product?.Variants?.Where(v => v.Id is not null)
                .Select(v => new VariantOption(v.Id!.Value, string.IsNullOrWhiteSpace(v.Sku) ? Short(v.Id!.Value) : v.Sku))
                .ToList() ?? [];
        }
        catch { _variants = []; }
    }

    // Filter the product picker by the search box; always keep the currently-selected product listed so a
    // filter that excludes it doesn't visually clear the selection.
    private IEnumerable<ProductListItem> FilteredProducts()
    {
        if (_products is null) { return []; }
        if (string.IsNullOrWhiteSpace(_productSearch)) { return _products; }
        var term = _productSearch.Trim();
        return _products.Where(p =>
            p.Id.ToString() == _form.ProductId ||
            p.Title.Contains(term, StringComparison.CurrentCultureIgnoreCase));
    }

    private string SupplierName(string supplierId) =>
        Guid.TryParse(supplierId, out var id)
            ? _suppliers?.FirstOrDefault(s => s.Id == id)?.Name ?? Short(id)
            : supplierId;

    private static Guid ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : Guid.Empty;

    private async Task<List<StorefrontDto>> SafeStorefronts()
    {
        try { return await Gateway.GetListAsync<StorefrontDto>($"/api/catalog/admin/storefronts?tenantId={Uri.EscapeDataString(_tenantId)}"); }
        catch { return []; }
    }

    private string StorefrontLabel(Guid? storefrontId) =>
        storefrontId is { } sid ? _storefronts?.FirstOrDefault(s => s.Id == sid)?.Name ?? Short(sid) : L["Offers.Storefront.All"];

    private string WindowLabel(OfferDto offer)
    {
        if (offer.ActiveFrom is null && offer.ActiveUntil is null) { return L["Offers.Window.Always"]; }
        var from = offer.ActiveFrom?.UtcDateTime.ToString("yyyy-MM-dd") ?? "…";
        var until = offer.ActiveUntil?.UtcDateTime.ToString("yyyy-MM-dd") ?? "…";
        return $"{from} → {until}";
    }

    private static int SupplyCategoryValue(string value) => value switch { "Physical" => 1, "Digital" => 2, "Service" => 3, _ => 1 };
    private static int FulfilmentTypeValue(string value) => value switch { "Dropship" => 1, "Warehouse" => 2, "DigitalDownload" => 3, "Subscription" => 4, "Usage" => 5, "ManualService" => 6, _ => 2 };
    private static int PricingModelValue(string value) => value switch { "OneTime" => 1, "Subscription" => 2, "UsageBased" => 3, "Tiered" => 4, _ => 1 };
    private static int BillingPeriodValue(string value) => value switch { "Once" => 1, "Monthly" => 2, "Yearly" => 3, _ => 1 };
    private static string Short(Guid id) => id.ToString()[..8];
    private string TierSummary(OfferDto offer) => offer.Tiers.Count == 0 ? string.Empty : L["Offers.Tier.Summary", offer.Tiers.Count];

    private sealed class OfferForm { public string ProductTitle { get; set; } = string.Empty; public string ProductId { get; set; } = string.Empty; public string VariantId { get; set; } = string.Empty; public string VariantSku { get; set; } = string.Empty; public string SupplierId { get; set; } = string.Empty; public int SupplyCategory { get; set; } = 1; public int FulfilmentType { get; set; } = 2; public long PriceMinor { get; set; } public string Currency { get; set; } = "EUR"; public int Priority { get; set; } public int PricingModel { get; set; } = 1; public int BillingPeriod { get; set; } = 1; public bool Active { get; set; } = true; public long SupplierCostMinor { get; set; } public string StorefrontId { get; set; } = string.Empty; public DateTime? ActiveFrom { get; set; } public DateTime? ActiveUntil { get; set; } public List<TierForm> Tiers { get; } = []; }
    private sealed class TierForm { public int FromQuantity { get; set; } = 1; public long UnitPriceMinor { get; set; } }
    private record PriceTierDto(int FromQuantity, long UnitPriceMinor);
    private record OfferDto(Guid Id, Guid TenantId, Guid ProductId, Guid? VariantId, Guid SupplierId, string SupplyCategory, string FulfilmentType, string PricingModel, string BillingPeriod, long PriceMinor, string Currency, int Priority, string Status, List<PriceTierDto> Tiers, long SupplierCostMinor = 0, string ProductTitle = "", string? VariantSku = null, Guid? StorefrontId = null, DateTimeOffset? ActiveFrom = null, DateTimeOffset? ActiveUntil = null);
    private record StorefrontDto(Guid Id, string Name, string Currency);

    // New-offer dropdown data. Products come from the admin catalog list; variants from a single product's
    // editor DTO; suppliers from the entity list (mirrors the Suppliers page shape).
    private sealed record ProductListItem(Guid Id, string Slug, string Title, string Brand, int VariantCount, long MinPriceMinor, int TotalStock, string? ImageUrl, int ProductType);
    private sealed record ProductEditorDto(Guid Id, string Title, List<VariantEditorDto> Variants);
    private sealed record VariantEditorDto(Guid? Id, string Sku);
    private sealed record SupplierSummary(Guid Id, Guid TenantId, int Type, string LegalName, string? TradingName, string DisplayName, int Status, DateTimeOffset CreatedAt, DateTimeOffset UpdatedAt, int? OnboardingState);
    private sealed record SupplierOption(Guid Id, string Name);
    private sealed record VariantOption(Guid Id, string Sku);
}
