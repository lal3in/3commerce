@page "/warehouse"
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> L
@inject SupplierGatewayClient Gateway
@rendermode InteractiveServer

<PageTitle>@L["Warehouse_Title"] — @L["App_Title"]</PageTitle>

<h1>@L["Warehouse_Title"]</h1>
<p>@L["Warehouse_Intro"]</p>

@if (loading)
{
    <p style="color:#6b7280;">@L["Warehouse_Loading"]</p>
}
else if (detail is null)
{
    <p style="color:#b45309;">@L["Warehouse_NotFound"]</p>
}
else
{
    <section style="margin:1rem 0;padding:1rem;background:#fff;border:1px solid #e5e7eb;border-radius:8px;max-width:42rem;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:1rem;">
            <h2 style="margin:0;">@detail.DisplayName</h2>
            <span style="font-size:.85rem;color:#6b7280;">@L["Warehouse_State"]:
                <strong style="color:@(detail.CanEditDirectly ? "#b45309" : "#047857");">@detail.OnboardingState</strong>
            </span>
        </div>
        @if (detail.CanEditDirectly)
        {
            <p style="color:#6b7280;font-size:.85rem;margin:.4rem 0 0;">@L["Warehouse_EditableHint"]</p>
        }
        else
        {
            <p style="color:#6b7280;font-size:.85rem;margin:.4rem 0 0;">@L["Warehouse_LockedHint"]</p>
        }
    </section>

    @if (error is not null)
    {
        <p style="color:#b91c1c;">@error</p>
    }
    @if (info is not null)
    {
        <p style="color:#047857;">@info</p>
    }

    <section style="margin:1rem 0;padding:1rem;background:#fff;border:1px solid #e5e7eb;border-radius:8px;max-width:42rem;">
        <h3 style="margin-top:0;">@L["Warehouse_Current"]</h3>
        @if (detail.Warehouse is null)
        {
            <p style="color:#9ca3af;">@L["Warehouse_None"]</p>
        }
        else
        {
            <p style="margin:.2rem 0;">
                @detail.Warehouse.Line1@(string.IsNullOrWhiteSpace(detail.Warehouse.Line2) ? "" : $", {detail.Warehouse.Line2}")<br />
                @detail.Warehouse.City @detail.Warehouse.Region @detail.Warehouse.Postcode<br />
                @detail.Warehouse.CountryCode
            </p>
        }
    </section>

    @if (detail.CanEditDirectly)
    {
        @* Not yet approved: the supplier sets its warehouse address directly via the Entity update path. *@
        <section style="margin:1rem 0;padding:1rem;background:#fff;border:1px solid #e5e7eb;border-radius:8px;max-width:42rem;">
            <h3 style="margin-top:0;">@L["Warehouse_EditHeading"]</h3>
            @WarehouseFields()
            <button @onclick="SaveAsync" disabled="@saving" title="@L["Warehouse_Save_Tooltip"]" style="background:#0f172a;color:#fff;border:0;padding:.5rem 1rem;border-radius:4px;">
                @(saving ? L["Warehouse_Saving"] : L["Warehouse_Save"])
            </button>
        </section>
    }
    else
    {
        @* Approved: fields are read-only above and any change goes through a maker-checker change request. *@
        <section style="margin:1rem 0;padding:1rem;background:#fff;border:1px solid #e5e7eb;border-radius:8px;max-width:42rem;">
            <h3 style="margin-top:0;">@L["Warehouse_RequestHeading"]</h3>
            <p style="color:#6b7280;font-size:.85rem;margin-top:0;">@L["Warehouse_RequestIntro"]</p>
            @WarehouseFields()
            <label title="@L["Warehouse_RequestSummary_Tooltip"]">
                @L["Warehouse_RequestSummary"]<br />
                <textarea @bind="requestSummary" title="@L["Warehouse_RequestSummary_Tooltip"]" style="width:100%;padding:.4rem;min-height:5rem;"></textarea>
            </label><br /><br />
            <button @onclick="RequestChangeAsync" disabled="@saving" title="@L["Warehouse_RequestSubmit_Tooltip"]" style="background:#0f172a;color:#fff;border:0;padding:.5rem 1rem;border-radius:4px;">
                @(saving ? L["Warehouse_Saving"] : L["Warehouse_RequestSubmit"])
            </button>
        </section>
    }
}

@code {
    private const int WarehouseAddressType = 5; // SupplierChangeRequestType.WarehouseAddress

    private SupplierWarehouse? detail;
    private bool loading = true;
    private bool saving;
    private string? error;
    private string? info;
    private string line1 = string.Empty;
    private string? line2;
    private string city = string.Empty;
    private string? region;
    private string postcode = string.Empty;
    private string country = string.Empty;
    private string requestSummary = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private RenderFragment WarehouseFields() =>@<text>
        <label title="@L["Warehouse_Line1_Tooltip"]">
            @L["Warehouse_Line1"]<br />
            <input @bind="line1" title="@L["Warehouse_Line1_Tooltip"]" style="width:100%;padding:.4rem;" />
        </label><br /><br />
        <label title="@L["Warehouse_Line2_Tooltip"]">
            @L["Warehouse_Line2"]<br />
            <input @bind="line2" title="@L["Warehouse_Line2_Tooltip"]" style="width:100%;padding:.4rem;" />
        </label><br /><br />
        <div style="display:flex;gap:1rem;">
            <label title="@L["Warehouse_City_Tooltip"]" style="flex:1;">
                @L["Warehouse_City"]<br />
                <input @bind="city" title="@L["Warehouse_City_Tooltip"]" style="width:100%;padding:.4rem;" />
            </label>
            <label title="@L["Warehouse_Region_Tooltip"]" style="flex:1;">
                @L["Warehouse_Region"]<br />
                <input @bind="region" title="@L["Warehouse_Region_Tooltip"]" style="width:100%;padding:.4rem;" />
            </label>
        </div><br />
        <div style="display:flex;gap:1rem;">
            <label title="@L["Warehouse_Postcode_Tooltip"]" style="flex:1;">
                @L["Warehouse_Postcode"]<br />
                <input @bind="postcode" title="@L["Warehouse_Postcode_Tooltip"]" style="width:100%;padding:.4rem;" />
            </label>
            <label title="@L["Warehouse_Country_Tooltip"]" style="flex:1;">
                @L["Warehouse_Country"]<br />
                <input @bind="country" maxlength="2" title="@L["Warehouse_Country_Tooltip"]" style="width:100%;padding:.4rem;" />
            </label>
        </div><br />
    </text>;

    private async Task LoadAsync()
    {
        loading = true;
        detail = await Gateway.GetAsync<SupplierWarehouse>("/api/entity/entities/suppliers/me/warehouse");
        if (detail?.Warehouse is { } w)
        {
            line1 = w.Line1;
            line2 = w.Line2;
            city = w.City;
            region = w.Region;
            postcode = w.Postcode;
            country = w.CountryCode;
        }

        loading = false;
    }

    private bool Validate()
    {
        error = info = null;
        if (string.IsNullOrWhiteSpace(line1) || string.IsNullOrWhiteSpace(city)
            || string.IsNullOrWhiteSpace(postcode) || country.Trim().Length != 2)
        {
            error = L["Warehouse_Validation_Address"];
            return false;
        }

        return true;
    }

    private object AddressPayload() => new
    {
        purpose = 4, // EntityAddressPurpose.Warehouse
        line1 = line1.Trim(),
        line2 = string.IsNullOrWhiteSpace(line2) ? null : line2!.Trim(),
        city = city.Trim(),
        region = string.IsNullOrWhiteSpace(region) ? null : region!.Trim(),
        postcode = postcode.Trim(),
        countryCode = country.Trim().ToUpperInvariant(),
    };

    private async Task SaveAsync()
    {
        if (!Validate())
        {
            return;
        }

        saving = true;
        try
        {
            var response = await Gateway.PutAsync("/api/entity/entities/suppliers/me/warehouse", AddressPayload());
            if (response.IsSuccessStatusCode)
            {
                info = L["Warehouse_Saved"];
                await LoadAsync();
            }
            else
            {
                error = L["Warehouse_SaveFailed"];
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task RequestChangeAsync()
    {
        if (!Validate())
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(requestSummary))
        {
            error = L["Warehouse_Validation_Summary"];
            return;
        }

        saving = true;
        try
        {
            // The proposed address rides in Detail as JSON so an approved request actually supersedes the
            // warehouse address; the summary is the human-readable reason the admin reviews.
            var proposed = System.Text.Json.JsonSerializer.Serialize(AddressPayload());
            var response = await Gateway.PostAsync("/api/entity/entities/suppliers/me/change-requests",
                new { type = WarehouseAddressType, summary = requestSummary.Trim(), detail = proposed });
            if (response.IsSuccessStatusCode)
            {
                info = L["Warehouse_RequestSubmitted"];
                requestSummary = string.Empty;
                await LoadAsync();
            }
            else
            {
                error = L["Warehouse_RequestFailed"];
            }
        }
        finally
        {
            saving = false;
        }
    }

    private sealed record SupplierWarehouse(
        Guid EntityId, string DisplayName, string OnboardingState, bool CanEditDirectly, AddressDto? Warehouse);
    private sealed record AddressDto(Guid Id, int Purpose, string Line1, string? Line2, string City, string? Region, string Postcode, string CountryCode);
}
