    "/cart/summary": {
      "get": {
        "tags": [
          "Cart"
        ],
        "summary": "The cart's money preview: offer-resolved subtotal, storefront-wide discount, threshold-promotion discount, items total, free shipping and the applied promotions (ADR-0051). Computed with the same evaluator checkout uses.",
        "parameters": [
          {
            "name": "storefrontId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
