  "components": {
    "schemas": {
      "AdminRefundRequest": {
        "required": [
          "orderId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "autoApprove": {
            "type": "boolean",
            "default": true
          },
          "lines": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/RmaLineSelection"
            }
          }
        }
      },
      "AdminTicketDto": {
        "required": [
          "id",
          "orderId",
          "email",
          "reason",
          "status",
          "createdAt",
          "messages",
          "attachments"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminTicketMessageDto"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentDto"
            }
          }
        }
      },
      "AdminTicketMessageDto": {
        "required": [
          "author",
          "body",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApproveRequest": {
        "required": [
          "requireReturn"
        ],
        "type": "object",
        "properties": {
          "requireReturn": {
            "type": "boolean"
          }
        }
      },
      "AttachmentDto": {
        "required": [
          "id",
          "fileName",
          "contentType",
          "sizeBytes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "CustomerRmaDto": {
        "required": [
          "id",
          "amountMinor",
          "currency",
          "reason",
          "state",
          "createdAt",
          "lines"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "amountMinor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerRmaLineDto"
            }
          }
        }
      },
      "CustomerRmaLineDto": {
        "required": [
          "productId",
          "title",
          "quantity",
          "unitPriceMinor"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unitPriceMinor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "DispositionRequest": {
        "required": [
          "kind",
          "storageReason",
          "comments",
          "tenantId",
          "restock"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "storageReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "comments": {
            "type": [
              "null",
              "string"
            ]
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "restock": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/RestockLineRequest"
            }
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "MessageDto": {
        "required": [
          "author",
          "body",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MessageRequest": {
        "required": [
          "body"
        ],
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          }
        }
      },
      "OpenTicketRequest": {
        "required": [
          "orderId",
          "email",
          "reason",
          "message"
        ],
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
