        "id": "request-path",
        "label": "Request path",
        "focus": [
          "clients",
          "storefront",
          "admin",
          "gateway",
          "services"
        ],
        "note": "Browser traffic enters the front-ends and is routed, authenticated, and claims-stamped by the gateway."
      },
      {
        "id": "state",
        "label": "State ownership",
        "focus": [
          "services",
          "postgres",
          "redis"
        ],
        "note": "Each service owns its own Postgres schema (FORCE RLS); Redis is the shared cache / session / idempotency store."
      },
      {
        "id": "events",
        "label": "Event fabric",
        "focus": [
          "services",
          "rabbitmq",
          "kafka"
        ],
        "note": "Services never call each other directly — RabbitMQ carries commands/sagas, Kafka carries committed facts."
      },
      {
        "id": "operations",
        "label": "Providers & telemetry",
        "focus": [
          "services",
          "providers",
          "observability"
        ],
        "note": "External money/accounting providers are adapter-gated; every hop emits OTLP to the LGTM stack."
      }
    ]
  },
