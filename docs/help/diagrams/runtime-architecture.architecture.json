  "cards": [
    {
      "dot": "cyan",
      "title": "The 14 microservices",
      "items": [
        "Identity · Catalog · Ordering · Payments · Fulfillment",
        "Support · Entity · Marketing · Pricing · Usage",
        "Entitlement · Workflow · Audit (+ Notifications worker)",
        "Each owns its Postgres schema behind the gateway"
      ]
    },
    {
      "dot": "violet",
      "title": "How they communicate",
      "items": [
        "No service-to-service HTTP — events + read-copy projections",
        "RabbitMQ / MassTransit: commands, sagas, transactional outbox",
        "Kafka: committed facts only, for durable replay (ADR-0034)",
        "Cross-service reads are local projections, never foreign queries"
      ]
    },
    {
      "dot": "emerald",
      "title": "Recent additions",
      "items": [
        "Entity owns the currency registry (master data) → CurrencyChanged",
        "Per-storefront ledger accounts live in Payments",
        "Quartz schedules jobs per service; Workflow aggregates run history",
        "Redis-backed rate-limit + idempotency + sessions (ADR-0044)"
      ]
    }
  ]
